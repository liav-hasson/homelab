{
  "uid": "quizlabs-overview",
  "title": "QuizLabs - Overview",
  "description": "QuizLabs legacy stack (quiz-backend, quiz-multiplayer/Socket.IO, MongoDB, Redis): route-bound edge traffic, errors and latency, readiness, resources, storage and logs. There are no application metrics, so nothing here counts players or games.",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "graphTooltip": 1,
  "tags": ["homelab-monitoring", "quizlabs", "overview"],
  "timezone": "browser",
  "refresh": "30s",
  "time": {"from": "now-6h", "to": "now"},
  "links": [
    {"type": "link", "title": "Runbook", "tooltip": "How to read this dashboard", "url": "https://github.com/liav-hasson/homelab/blob/main/k8s/platform/monitoring/runbook.md#quizlabs-overview", "icon": "doc", "targetBlank": true},
    {"type": "dashboards", "tags": ["homelab-monitoring"], "title": "Monitoring", "asDropdown": true, "keepTime": true, "includeVars": true}
  ],
  "templating": {"list": [{"name": "metrics", "label": "Prometheus", "type": "datasource", "query": "prometheus"}, {"name": "logs", "label": "Loki", "type": "datasource", "query": "loki"}]},
  "panels": [
    {
      "id": 1, "type": "row", "title": "At a glance", "collapsed": false,
      "gridPos": {"x": 0, "y": 0, "w": 24, "h": 1},
      "panels": []
    },
    {
      "id": 2, "type": "stat", "title": "Route requests (15 min)",
      "description": "Envoy requests to each QuizLabs route in the last 15 minutes: backend (rule 0), socket.io (rule 1), frontend (rule 2). Polling and upgrade requests are not game messages.",
      "gridPos": {"x": 0, "y": 1, "w": 6, "h": 5},
      "datasource": {"type": "prometheus", "uid": "${metrics}"},
      "fieldConfig": {"defaults": {"unit": "short", "color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [{"color": "blue", "value": null}]}, "mappings": [], "decimals": 0}, "overrides": []},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "orientation": "auto", "textMode": "value_and_name", "colorMode": "value", "graphMode": "area", "justifyMode": "auto", "wideLayout": true, "showPercentChange": false},
      "targets": [{"refId": "A", "expr": "sum by (envoy_cluster_name) (increase(envoy_cluster_upstream_rq_total{namespace=\"envoy-gateway-system\",envoy_cluster_name=~\"httproute/quizlabs/quizlabs/.*\"}[15m]))", "legendFormat": "{{envoy_cluster_name}}"}],
      "transformations": [{"id": "renameByRegex", "options": {"regex": "(.*)httproute/quizlabs/quizlabs/rule/0", "renamePattern": "$1backend"}}, {"id": "renameByRegex", "options": {"regex": "(.*)httproute/quizlabs/quizlabs/rule/1", "renamePattern": "$1socket.io"}}, {"id": "renameByRegex", "options": {"regex": "(.*)httproute/quizlabs/quizlabs/rule/2", "renamePattern": "$1frontend"}}]
    },
    {
      "id": 3, "type": "stat", "title": "5xx share (15 min)",
      "description": "Share of QuizLabs upstream responses that were 5xx in the last 15 minutes, all routes. Empty without traffic.",
      "gridPos": {"x": 6, "y": 1, "w": 5, "h": 5},
      "datasource": {"type": "prometheus", "uid": "${metrics}"},
      "fieldConfig": {"defaults": {"unit": "percent", "color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 0.001}, {"color": "red", "value": 5}]}, "mappings": [], "decimals": 1}, "overrides": []},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "orientation": "auto", "textMode": "auto", "colorMode": "value", "graphMode": "area", "justifyMode": "auto", "wideLayout": true, "showPercentChange": false},
      "targets": [{"refId": "A", "expr": "100 * (sum(increase(envoy_cluster_upstream_rq_xx{namespace=\"envoy-gateway-system\",envoy_cluster_name=~\"httproute/quizlabs/quizlabs/.*\",envoy_response_code_class=\"5\"}[15m])) or sum(increase(envoy_cluster_upstream_rq_xx{namespace=\"envoy-gateway-system\",envoy_cluster_name=~\"httproute/quizlabs/quizlabs/.*\"}[15m])) * 0) / (sum(increase(envoy_cluster_upstream_rq_xx{namespace=\"envoy-gateway-system\",envoy_cluster_name=~\"httproute/quizlabs/quizlabs/.*\"}[15m])) > 0)", "legendFormat": "5xx"}]
    },
    {
      "id": 4, "type": "stat", "title": "Envoy failures (15m)",
      "description": "Upstream connections Envoy could not open and requests that timed out on QuizLabs routes in the last 15 minutes (EdgeUpstreamFailure).",
      "gridPos": {"x": 11, "y": 1, "w": 5, "h": 5},
      "datasource": {"type": "prometheus", "uid": "${metrics}"},
      "fieldConfig": {"defaults": {"unit": "short", "color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 1}]}, "mappings": [], "decimals": 0}, "overrides": []},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "orientation": "auto", "textMode": "value_and_name", "colorMode": "value", "graphMode": "area", "justifyMode": "auto", "wideLayout": true, "showPercentChange": false},
      "targets": [{"refId": "A", "expr": "sum(increase(envoy_cluster_upstream_cx_connect_fail{namespace=\"envoy-gateway-system\",envoy_cluster_name=~\"httproute/quizlabs/quizlabs/.*\"}[15m]))", "legendFormat": "connect"}, {"refId": "B", "expr": "sum(increase(envoy_cluster_upstream_rq_timeout{namespace=\"envoy-gateway-system\",envoy_cluster_name=~\"httproute/quizlabs/quizlabs/.*\"}[15m]))", "legendFormat": "timeout"}]
    },
    {
      "id": 5, "type": "stat", "title": "Backend p95 (15 min)",
      "description": "95th percentile upstream time of quiz-backend requests (rule 0) over 15 minutes, shown only with at least 5 requests.",
      "gridPos": {"x": 16, "y": 1, "w": 4, "h": 5},
      "datasource": {"type": "prometheus", "uid": "${metrics}"},
      "fieldConfig": {"defaults": {"unit": "ms", "color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 1000}, {"color": "red", "value": 5000}]}, "mappings": []}, "overrides": []},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "orientation": "auto", "textMode": "auto", "colorMode": "value", "graphMode": "area", "justifyMode": "auto", "wideLayout": true, "showPercentChange": false},
      "targets": [{"refId": "A", "expr": "histogram_quantile(0.95, sum by (envoy_cluster_name, le) (increase(envoy_cluster_upstream_rq_time_bucket{namespace=\"envoy-gateway-system\",envoy_cluster_name=\"httproute/quizlabs/quizlabs/rule/0\"}[15m]))) and on (envoy_cluster_name) sum by (envoy_cluster_name) (increase(envoy_cluster_upstream_rq_time_count{namespace=\"envoy-gateway-system\",envoy_cluster_name=\"httproute/quizlabs/quizlabs/rule/0\"}[15m])) >= 5", "legendFormat": "backend"}]
    },
    {
      "id": 6, "type": "stat", "title": "Socket.IO connections",
      "description": "Open Envoy connections to the Socket.IO backend (rule 1): proxy connections, not players, rooms or WebSocket sessions.",
      "gridPos": {"x": 20, "y": 1, "w": 4, "h": 5},
      "datasource": {"type": "prometheus", "uid": "${metrics}"},
      "fieldConfig": {"defaults": {"unit": "short", "color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [{"color": "blue", "value": null}]}, "mappings": []}, "overrides": []},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "orientation": "auto", "textMode": "auto", "colorMode": "value", "graphMode": "area", "justifyMode": "auto", "wideLayout": true, "showPercentChange": false},
      "targets": [{"refId": "A", "expr": "sum(envoy_cluster_upstream_cx_active{namespace=\"envoy-gateway-system\",envoy_cluster_name=\"httproute/quizlabs/quizlabs/rule/1\"})", "legendFormat": "connections"}]
    },
    {
      "id": 7, "type": "row", "title": "Availability", "collapsed": false,
      "gridPos": {"x": 0, "y": 6, "w": 24, "h": 1},
      "panels": []
    },
    {
      "id": 8, "type": "state-timeline", "title": "Workload availability",
      "description": "Available (Deployments) or ready (MongoDB StatefulSet) over desired replicas. Readiness is not a successful datastore command; QuizLabsMongoUnavailable fires when no MongoDB replica is ready.",
      "gridPos": {"x": 0, "y": 7, "w": 12, "h": 7},
      "datasource": {"type": "prometheus", "uid": "${metrics}"},
      "fieldConfig": {"defaults": {"unit": "percentunit", "color": {"mode": "fixed", "fixedColor": "blue"}, "mappings": [{"type": "range", "options": {"result": {"color": "green", "index": 0}, "from": 1}}, {"type": "range", "options": {"result": {"color": "red", "index": 1}, "to": 0.9999}}], "custom": {"lineWidth": 0, "fillOpacity": 75}}, "overrides": []},
      "options": {"showValue": "auto", "rowHeight": 0.85, "mergeValues": true, "alignValue": "left", "legend": {"showLegend": false, "displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "single", "sort": "none"}},
      "targets": [{"refId": "A", "expr": "kube_deployment_status_replicas_available{namespace=\"quizlabs\"} / on (namespace, deployment) kube_deployment_spec_replicas{namespace=\"quizlabs\"}", "legendFormat": "{{deployment}}"}, {"refId": "B", "expr": "kube_statefulset_status_replicas_ready{namespace=\"quizlabs\"} / on (namespace, statefulset) kube_statefulset_replicas{namespace=\"quizlabs\"}", "legendFormat": "{{statefulset}}"}]
    },
    {
      "id": 9, "type": "state-timeline", "title": "Flux delivery readiness",
      "description": "Ready condition of the Flux objects that deliver QuizLabs. Red means the cluster is not running what Git says; revisions are on Platform - Delivery & Edge.",
      "gridPos": {"x": 12, "y": 7, "w": 12, "h": 7},
      "datasource": {"type": "prometheus", "uid": "${metrics}"},
      "fieldConfig": {"defaults": {"unit": "short", "color": {"mode": "fixed", "fixedColor": "blue"}, "mappings": [{"type": "value", "options": {"-1": {"text": "Unknown", "color": "orange", "index": 0}, "0": {"text": "Not ready", "color": "red", "index": 1}, "1": {"text": "Ready", "color": "green", "index": 2}}}], "custom": {"lineWidth": 0, "fillOpacity": 75}}, "overrides": []},
      "options": {"showValue": "never", "rowHeight": 0.85, "mergeValues": true, "alignValue": "left", "legend": {"showLegend": false, "displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "single", "sort": "none"}},
      "targets": [{"refId": "A", "expr": "min by (customresource_kind, name) (gotk_resource_info{exported_namespace=\"quizlabs\",ready=\"True\"} * 1 or gotk_resource_info{exported_namespace=\"quizlabs\",ready=\"False\"} * 0 or gotk_resource_info{exported_namespace=\"quizlabs\",ready!~\"True|False\"} * -1)", "legendFormat": "{{customresource_kind}} {{name}}"}]
    },
    {
      "id": 10, "type": "row", "title": "Edge traffic", "collapsed": false,
      "gridPos": {"x": 0, "y": 14, "w": 24, "h": 1},
      "panels": []
    },
    {
      "id": 11, "type": "timeseries", "title": "Route requests",
      "description": "Envoy requests per QuizLabs route and bar (15 minutes, longer on wide ranges), stacked to the total.",
      "gridPos": {"x": 0, "y": 15, "w": 8, "h": 7},
      "datasource": {"type": "prometheus", "uid": "${metrics}"},
      "fieldConfig": {"defaults": {"unit": "short", "custom": {"drawStyle": "bars", "lineWidth": 1, "fillOpacity": 80, "showPoints": "never", "spanNulls": false, "stacking": {"mode": "normal", "group": "A"}, "barAlignment": -1}, "color": {"mode": "palette-classic"}, "min": 0}, "overrides": []},
      "options": {"legend": {"showLegend": true, "displayMode": "list", "placement": "bottom", "calcs": []}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "interval": "15m",
      "transformations": [{"id": "renameByRegex", "options": {"regex": "(.*)httproute/quizlabs/quizlabs/rule/0", "renamePattern": "$1backend"}}, {"id": "renameByRegex", "options": {"regex": "(.*)httproute/quizlabs/quizlabs/rule/1", "renamePattern": "$1socket.io"}}, {"id": "renameByRegex", "options": {"regex": "(.*)httproute/quizlabs/quizlabs/rule/2", "renamePattern": "$1frontend"}}],
      "targets": [{"refId": "A", "expr": "sum by (envoy_cluster_name) (increase(envoy_cluster_upstream_rq_total{namespace=\"envoy-gateway-system\",envoy_cluster_name=~\"httproute/quizlabs/quizlabs/.*\"}[$__rate_interval]))", "legendFormat": "{{envoy_cluster_name}}"}]
    },
    {
      "id": 12, "type": "timeseries", "title": "Responses by status class",
      "description": "Upstream responses on QuizLabs routes per status class and bar, stacked to the total. 5xx come from the backends or Envoy; check readiness and logs.",
      "gridPos": {"x": 8, "y": 15, "w": 8, "h": 7},
      "datasource": {"type": "prometheus", "uid": "${metrics}"},
      "fieldConfig": {"defaults": {"unit": "short", "custom": {"drawStyle": "bars", "lineWidth": 1, "fillOpacity": 80, "showPoints": "never", "spanNulls": false, "stacking": {"mode": "normal", "group": "A"}, "barAlignment": -1}, "color": {"mode": "palette-classic"}, "min": 0}, "overrides": []},
      "options": {"legend": {"showLegend": true, "displayMode": "list", "placement": "bottom", "calcs": []}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "interval": "15m",
      "targets": [{"refId": "A", "expr": "sum by (envoy_response_code_class) (increase(envoy_cluster_upstream_rq_xx{namespace=\"envoy-gateway-system\",envoy_cluster_name=~\"httproute/quizlabs/quizlabs/.*\"}[$__rate_interval]))", "legendFormat": "{{envoy_response_code_class}}xx"}]
    },
    {
      "id": 13, "type": "timeseries", "title": "Connect failures and timeouts",
      "description": "Failed upstream connections and request timeouts per QuizLabs route and bar. Any bar means Envoy could not reach that backend; check its readiness and logs.",
      "gridPos": {"x": 16, "y": 15, "w": 8, "h": 7},
      "datasource": {"type": "prometheus", "uid": "${metrics}"},
      "fieldConfig": {"defaults": {"unit": "short", "custom": {"drawStyle": "bars", "lineWidth": 1, "fillOpacity": 80, "showPoints": "never", "spanNulls": false, "stacking": {"mode": "normal", "group": "A"}, "barAlignment": -1}, "color": {"mode": "palette-classic"}, "min": 0}, "overrides": []},
      "options": {"legend": {"showLegend": true, "displayMode": "list", "placement": "bottom", "calcs": []}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "interval": "15m",
      "transformations": [{"id": "renameByRegex", "options": {"regex": "(.*)httproute/quizlabs/quizlabs/rule/0", "renamePattern": "$1backend"}}, {"id": "renameByRegex", "options": {"regex": "(.*)httproute/quizlabs/quizlabs/rule/1", "renamePattern": "$1socket.io"}}, {"id": "renameByRegex", "options": {"regex": "(.*)httproute/quizlabs/quizlabs/rule/2", "renamePattern": "$1frontend"}}],
      "targets": [{"refId": "A", "expr": "sum by (envoy_cluster_name) (increase(envoy_cluster_upstream_cx_connect_fail{namespace=\"envoy-gateway-system\",envoy_cluster_name=~\"httproute/quizlabs/quizlabs/.*\"}[$__rate_interval]))", "legendFormat": "connect fail {{envoy_cluster_name}}"}, {"refId": "B", "expr": "sum by (envoy_cluster_name) (increase(envoy_cluster_upstream_rq_timeout{namespace=\"envoy-gateway-system\",envoy_cluster_name=~\"httproute/quizlabs/quizlabs/.*\"}[$__rate_interval]))", "legendFormat": "timeout {{envoy_cluster_name}}"}]
    },
    {
      "id": 14, "type": "heatmap", "title": "Backend latency distribution",
      "description": "quiz-backend (rule 0) requests per Envoy upstream-time bucket and 5-minute column, in milliseconds.",
      "gridPos": {"x": 0, "y": 22, "w": 12, "h": 7},
      "datasource": {"type": "prometheus", "uid": "${metrics}"},
      "interval": "5m",
      "fieldConfig": {"defaults": {"custom": {"hideFrom": {"legend": false, "tooltip": false, "viz": false}, "scaleDistribution": {"type": "linear"}}}, "overrides": []},
      "options": {"calculate": false, "cellGap": 1, "cellValues": {"unit": "short"}, "color": {"mode": "scheme", "scheme": "Oranges", "fill": "dark-orange", "scale": "exponential", "exponent": 0.5, "steps": 64, "reverse": false}, "exemplars": {"color": "rgba(255,0,255,0.7)"}, "filterValues": {"le": 1e-09}, "legend": {"show": true}, "rowsFrame": {"layout": "auto"}, "showValue": "never", "tooltip": {"mode": "single", "yHistogram": false, "showColorScale": false}, "yAxis": {"axisPlacement": "left", "reverse": false, "unit": "ms"}, "selectionMode": "x"},
      "targets": [{"refId": "A", "expr": "sum by (le) (increase(envoy_cluster_upstream_rq_time_bucket{namespace=\"envoy-gateway-system\",envoy_cluster_name=\"httproute/quizlabs/quizlabs/rule/0\"}[$__rate_interval]))", "legendFormat": "{{le}}", "format": "heatmap"}]
    },
    {
      "id": 15, "type": "timeseries", "title": "p95 upstream time: backend and frontend",
      "description": "95th percentile Envoy upstream time of the backend and frontend routes over a rolling 15 minutes, shown only with at least 5 requests. socket.io is left out: long-polling holds requests open by design, so its upstream time is not user latency.",
      "gridPos": {"x": 12, "y": 22, "w": 12, "h": 7},
      "datasource": {"type": "prometheus", "uid": "${metrics}"},
      "fieldConfig": {"defaults": {"unit": "ms", "custom": {"drawStyle": "line", "lineWidth": 1, "fillOpacity": 10, "showPoints": "never", "spanNulls": false, "stacking": {"mode": "none", "group": "A"}}, "color": {"mode": "palette-classic"}, "min": 0}, "overrides": []},
      "options": {"legend": {"showLegend": true, "displayMode": "list", "placement": "bottom", "calcs": []}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "transformations": [{"id": "renameByRegex", "options": {"regex": "(.*)httproute/quizlabs/quizlabs/rule/0", "renamePattern": "$1backend"}}, {"id": "renameByRegex", "options": {"regex": "(.*)httproute/quizlabs/quizlabs/rule/1", "renamePattern": "$1socket.io"}}, {"id": "renameByRegex", "options": {"regex": "(.*)httproute/quizlabs/quizlabs/rule/2", "renamePattern": "$1frontend"}}],
      "targets": [{"refId": "A", "expr": "histogram_quantile(0.95, sum by (envoy_cluster_name, le) (increase(envoy_cluster_upstream_rq_time_bucket{namespace=\"envoy-gateway-system\",envoy_cluster_name=~\"httproute/quizlabs/quizlabs/rule/(0|2)\"}[15m]))) and on (envoy_cluster_name) sum by (envoy_cluster_name) (increase(envoy_cluster_upstream_rq_time_count{namespace=\"envoy-gateway-system\",envoy_cluster_name=~\"httproute/quizlabs/quizlabs/rule/(0|2)\"}[15m])) >= 5", "legendFormat": "{{envoy_cluster_name}}"}]
    },
    {
      "id": 16, "type": "row", "title": "Resources", "collapsed": false,
      "gridPos": {"x": 0, "y": 29, "w": 24, "h": 1},
      "panels": []
    },
    {
      "id": 17, "type": "bargauge", "title": "Memory working set of limit",
      "description": "Working set as a share of the configured memory limit; containers without a limit are absent. Near 100% the container is OOM-killed.",
      "gridPos": {"x": 0, "y": 30, "w": 8, "h": 8},
      "datasource": {"type": "prometheus", "uid": "${metrics}"},
      "fieldConfig": {"defaults": {"unit": "percent", "min": 0, "max": 100, "color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 80}, {"color": "red", "value": 90}]}}, "overrides": []},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "orientation": "horizontal", "displayMode": "lcd", "valueMode": "color", "namePlacement": "top", "showUnfilled": true, "sizing": "auto", "minVizWidth": 8, "minVizHeight": 16, "maxVizHeight": 300, "legend": {"showLegend": false, "displayMode": "list", "placement": "bottom", "calcs": []}},
      "targets": [{"refId": "A", "expr": "100 * max by (namespace, pod, container) (container_memory_working_set_bytes{namespace=\"quizlabs\",container!=\"\",container!=\"POD\"}) / on (namespace, pod, container) (max by (namespace, pod, container) (kube_pod_container_resource_limits{namespace=\"quizlabs\",resource=\"memory\",unit=\"byte\"}) > 0)", "legendFormat": "{{pod}} / {{container}}"}]
    },
    {
      "id": 18, "type": "timeseries", "title": "Container memory working set",
      "description": "Memory working set per QuizLabs container. Compare with its limit beside before changing limits.",
      "gridPos": {"x": 8, "y": 30, "w": 8, "h": 8},
      "datasource": {"type": "prometheus", "uid": "${metrics}"},
      "fieldConfig": {"defaults": {"unit": "bytes", "custom": {"drawStyle": "line", "lineWidth": 1, "fillOpacity": 10, "showPoints": "never", "spanNulls": false, "stacking": {"mode": "none", "group": "A"}}, "color": {"mode": "palette-classic"}, "min": 0}, "overrides": []},
      "options": {"legend": {"showLegend": true, "displayMode": "list", "placement": "bottom", "calcs": []}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [{"refId": "A", "expr": "max by (pod, container) (container_memory_working_set_bytes{namespace=\"quizlabs\",container!=\"\",container!=\"POD\"})", "legendFormat": "{{pod}} {{container}}"}]
    },
    {
      "id": 19, "type": "timeseries", "title": "Container CPU",
      "description": "CPU cores used per QuizLabs container. A sustained climb alongside restarts points at that component.",
      "gridPos": {"x": 16, "y": 30, "w": 8, "h": 8},
      "datasource": {"type": "prometheus", "uid": "${metrics}"},
      "fieldConfig": {"defaults": {"unit": "cores", "custom": {"drawStyle": "line", "lineWidth": 1, "fillOpacity": 10, "showPoints": "never", "spanNulls": false, "stacking": {"mode": "none", "group": "A"}}, "color": {"mode": "palette-classic"}, "min": 0}, "overrides": []},
      "options": {"legend": {"showLegend": true, "displayMode": "list", "placement": "bottom", "calcs": []}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [{"refId": "A", "expr": "sum by (pod, container) (rate(container_cpu_usage_seconds_total{namespace=\"quizlabs\",container!=\"\",container!=\"POD\"}[$__rate_interval]))", "legendFormat": "{{pod}} {{container}}"}]
    },
    {
      "id": 20, "type": "timeseries", "title": "Container restarts",
      "description": "Container restarts per bar. Check Recent OOM restarts and the component's logs for the cause.",
      "gridPos": {"x": 0, "y": 38, "w": 8, "h": 7},
      "datasource": {"type": "prometheus", "uid": "${metrics}"},
      "fieldConfig": {"defaults": {"unit": "short", "custom": {"drawStyle": "bars", "lineWidth": 1, "fillOpacity": 80, "showPoints": "never", "spanNulls": false, "stacking": {"mode": "normal", "group": "A"}, "barAlignment": -1}, "color": {"mode": "palette-classic"}, "min": 0}, "overrides": []},
      "options": {"legend": {"showLegend": true, "displayMode": "list", "placement": "bottom", "calcs": []}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "interval": "15m",
      "targets": [{"refId": "A", "expr": "sum by (pod, container) (increase(kube_pod_container_status_restarts_total{namespace=\"quizlabs\"}[$__rate_interval]))", "legendFormat": "{{pod}} {{container}}"}]
    },
    {
      "id": 21, "type": "table", "title": "Recent OOM restarts",
      "description": "Containers whose last termination was an OOM kill and that restarted in the last 15 minutes. Empty means none observed, not complete coverage.",
      "gridPos": {"x": 8, "y": 38, "w": 8, "h": 7},
      "datasource": {"type": "prometheus", "uid": "${metrics}"},
