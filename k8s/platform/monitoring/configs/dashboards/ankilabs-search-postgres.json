{
  "uid": "ankilabs-search-postgres",
  "title": "AnkiLabs - Search & PostgreSQL",
  "description": "AnkiLabs lookup requests, stages, connection pools, search rows and read-only PostgreSQL health. No query text or statement statistics are collected.",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "graphTooltip": 1,
  "tags": ["homelab-monitoring", "ankilabs", "database"],
  "timezone": "browser",
  "refresh": "30s",
  "time": {"from": "now-6h", "to": "now"},
  "links": [
    {"type": "link", "title": "Runbook", "tooltip": "How to read this dashboard", "url": "https://github.com/liav-hasson/homelab/blob/main/k8s/platform/monitoring/runbook.md#ankilabs-search-and-postgresql", "icon": "doc", "targetBlank": true},
    {"type": "dashboards", "tags": ["homelab-monitoring"], "title": "Monitoring", "asDropdown": true, "keepTime": true, "includeVars": true}
  ],
  "templating": {"list": [{"name": "metrics", "label": "Prometheus", "type": "datasource", "query": "prometheus"}, {"name": "logs", "label": "Loki", "type": "datasource", "query": "loki"}, {"name": "request_id", "label": "Request ID contains (query-time only)", "type": "textbox", "query": "", "current": {"text": "", "value": ""}}, {"name": "fingerprint", "label": "Query fingerprint contains (query-time only)", "type": "textbox", "query": "", "current": {"text": "", "value": ""}}, {"name": "backend_pid", "label": "PG backend PID contains (query-time only)", "type": "textbox", "query": "", "current": {"text": "", "value": ""}}, {"name": "sentence_stage", "label": "Sentence stage", "type": "query", "datasource": {"type": "prometheus", "uid": "${metrics}"}, "query": {"query": "label_values(ankilabs_sentence_lookup_stage_duration_seconds_count{namespace=\"ankilabs\"}, stage)", "refId": "sentence_stage-variable"}, "definition": "label_values(ankilabs_sentence_lookup_stage_duration_seconds_count{namespace=\"ankilabs\"}, stage)", "refresh": 2, "sort": 1, "multi": false, "includeAll": false, "current": {"text": "search", "value": "search"}}, {"name": "dictionary_stage", "label": "Dictionary stage", "type": "query", "datasource": {"type": "prometheus", "uid": "${metrics}"}, "query": {"query": "label_values(ankilabs_dictionary_lookup_stage_duration_seconds_count{namespace=\"ankilabs\"}, stage)", "refId": "dictionary_stage-variable"}, "definition": "label_values(ankilabs_dictionary_lookup_stage_duration_seconds_count{namespace=\"ankilabs\"}, stage)", "refresh": 2, "sort": 1, "multi": false, "includeAll": false, "current": {"text": "query", "value": "query"}}, {"name": "phase", "label": "Search phase", "type": "query", "datasource": {"type": "prometheus", "uid": "${metrics}"}, "query": {"query": "label_values(ankilabs_sentence_lookup_search_rows_count{namespace=\"ankilabs\"}, phase)", "refId": "phase-variable"}, "definition": "label_values(ankilabs_sentence_lookup_search_rows_count{namespace=\"ankilabs\"}, phase)", "refresh": 2, "sort": 1, "multi": false, "includeAll": false, "current": {"text": "candidate", "value": "candidate"}}]},
  "panels": [
    {
      "id": 1, "type": "row", "title": "At a glance", "collapsed": false,
      "gridPos": {"x": 0, "y": 0, "w": 24, "h": 1},
      "panels": []
    },
    {
      "id": 2, "type": "stat", "title": "Requests (15 min)",
      "description": "Completed HTTP requests per service in the last 15 minutes; the sparkline is the same rolling count.",
      "gridPos": {"x": 0, "y": 1, "w": 5, "h": 5},
      "datasource": {"type": "prometheus", "uid": "${metrics}"},
      "fieldConfig": {"defaults": {"unit": "short", "color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [{"color": "blue", "value": null}]}, "mappings": [], "decimals": 0}, "overrides": []},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "orientation": "auto", "textMode": "value_and_name", "colorMode": "value", "graphMode": "area", "justifyMode": "auto", "wideLayout": true, "showPercentChange": false},
      "targets": [{"refId": "A", "expr": "sum(increase(ankilabs_sentence_lookup_http_request_duration_seconds_count{namespace=\"ankilabs\"}[15m]))", "legendFormat": "sentence-lookup"}, {"refId": "B", "expr": "sum(increase(ankilabs_dictionary_lookup_http_request_duration_seconds_count{namespace=\"ankilabs\"}[15m]))", "legendFormat": "dictionary-lookup"}]
    },
    {
      "id": 3, "type": "stat", "title": "5xx share (15 min)",
      "description": "Share of completed requests that returned 5xx in the last 15 minutes. Empty without traffic; any 5xx fires AnkiLabsRequestFailure.",
      "gridPos": {"x": 5, "y": 1, "w": 5, "h": 5},
      "datasource": {"type": "prometheus", "uid": "${metrics}"},
      "fieldConfig": {"defaults": {"unit": "percent", "color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 0.001}, {"color": "red", "value": 5}]}, "mappings": [], "decimals": 1}, "overrides": []},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "orientation": "auto", "textMode": "value_and_name", "colorMode": "value", "graphMode": "area", "justifyMode": "auto", "wideLayout": true, "showPercentChange": false},
      "targets": [{"refId": "A", "expr": "100 * (sum(increase(ankilabs_sentence_lookup_http_request_duration_seconds_count{namespace=\"ankilabs\",status=~\"5..\"}[15m])) or sum(increase(ankilabs_sentence_lookup_http_request_duration_seconds_count{namespace=\"ankilabs\"}[15m])) * 0) / (sum(increase(ankilabs_sentence_lookup_http_request_duration_seconds_count{namespace=\"ankilabs\"}[15m])) > 0)", "legendFormat": "sentence-lookup"}, {"refId": "B", "expr": "100 * (sum(increase(ankilabs_dictionary_lookup_http_request_duration_seconds_count{namespace=\"ankilabs\",status=~\"5..\"}[15m])) or sum(increase(ankilabs_dictionary_lookup_http_request_duration_seconds_count{namespace=\"ankilabs\"}[15m])) * 0) / (sum(increase(ankilabs_dictionary_lookup_http_request_duration_seconds_count{namespace=\"ankilabs\"}[15m])) > 0)", "legendFormat": "dictionary-lookup"}]
    },
    {
      "id": 4, "type": "stat", "title": "p95 latency (15 min)",
      "description": "95th percentile request duration per service over 15 minutes, shown only with at least 5 requests in that window.",
      "gridPos": {"x": 10, "y": 1, "w": 5, "h": 5},
      "datasource": {"type": "prometheus", "uid": "${metrics}"},
      "fieldConfig": {"defaults": {"unit": "s", "color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 1}, {"color": "red", "value": 5}]}, "mappings": []}, "overrides": []},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "orientation": "auto", "textMode": "value_and_name", "colorMode": "value", "graphMode": "area", "justifyMode": "auto", "wideLayout": true, "showPercentChange": false},
      "targets": [{"refId": "A", "expr": "histogram_quantile(0.95, sum by (job, le) (increase(ankilabs_sentence_lookup_http_request_duration_seconds_bucket{namespace=\"ankilabs\"}[15m]))) and on (job) sum by (job) (increase(ankilabs_sentence_lookup_http_request_duration_seconds_count{namespace=\"ankilabs\"}[15m])) >= 5", "legendFormat": "sentence-lookup"}, {"refId": "B", "expr": "histogram_quantile(0.95, sum by (job, le) (increase(ankilabs_dictionary_lookup_http_request_duration_seconds_bucket{namespace=\"ankilabs\"}[15m]))) and on (job) sum by (job) (increase(ankilabs_dictionary_lookup_http_request_duration_seconds_count{namespace=\"ankilabs\"}[15m])) >= 5", "legendFormat": "dictionary-lookup"}]
    },
    {
      "id": 5, "type": "stat", "title": "Pool waiters",
      "description": "Requests waiting for a database connection, worst pod per lookup. Waiters for 3 minutes fire LookupPoolWaiting.",
      "gridPos": {"x": 15, "y": 1, "w": 4, "h": 5},
      "datasource": {"type": "prometheus", "uid": "${metrics}"},
      "fieldConfig": {"defaults": {"unit": "short", "color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 1}]}, "mappings": []}, "overrides": []},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "orientation": "auto", "textMode": "value_and_name", "colorMode": "value", "graphMode": "area", "justifyMode": "auto", "wideLayout": true, "showPercentChange": false},
      "targets": [{"refId": "A", "expr": "max(ankilabs_sentence_lookup_db_pool_connections{namespace=\"ankilabs\",state=\"waiting\"})", "legendFormat": "sentence"}, {"refId": "B", "expr": "max(ankilabs_dictionary_lookup_db_pool_connections{namespace=\"ankilabs\",state=\"waiting\"})", "legendFormat": "dictionary"}]
    },
    {
      "id": 6, "type": "stat", "title": "PostgreSQL",
      "description": "Exporter connection to the database (pg_up) and the number of enabled collectors currently failing. A reachable exporter can still fail collectors, for example without the monitoring login.",
      "gridPos": {"x": 19, "y": 1, "w": 5, "h": 5},
      "datasource": {"type": "prometheus", "uid": "${metrics}"},
      "fieldConfig": {"defaults": {"unit": "short", "color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [{"color": "blue", "value": null}]}, "mappings": []}, "overrides": [{"matcher": {"id": "byName", "options": "database"}, "properties": [{"id": "mappings", "value": [{"type": "value", "options": {"0": {"text": "Down", "color": "red", "index": 0}, "1": {"text": "Up", "color": "green", "index": 1}}}]}, {"id": "thresholds", "value": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}]}}]}, {"matcher": {"id": "byName", "options": "failing collectors"}, "properties": [{"id": "thresholds", "value": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 1}]}}]}]},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "orientation": "auto", "textMode": "value_and_name", "colorMode": "value", "graphMode": "area", "justifyMode": "auto", "wideLayout": true, "showPercentChange": false},
      "targets": [{"refId": "A", "expr": "max(pg_up{namespace=\"ankilabs\"})", "legendFormat": "database"}, {"refId": "B", "expr": "count(pg_scrape_collector_success{namespace=\"ankilabs\"} == 0) or count(pg_scrape_collector_success{namespace=\"ankilabs\"}) * 0", "legendFormat": "failing collectors"}]
    },
    {
      "id": 7, "type": "row", "title": "Lookup requests", "collapsed": false,
      "gridPos": {"x": 0, "y": 6, "w": 24, "h": 1},
      "panels": []
    },
    {
      "id": 8, "type": "timeseries", "title": "Lookup requests by service, route and status",
      "description": "Completed lookup HTTP requests per bar (15 minutes, longer on wide ranges), stacked to the total.",
      "gridPos": {"x": 0, "y": 7, "w": 12, "h": 7},
      "datasource": {"type": "prometheus", "uid": "${metrics}"},
      "fieldConfig": {"defaults": {"unit": "short", "custom": {"drawStyle": "bars", "lineWidth": 1, "fillOpacity": 80, "showPoints": "never", "spanNulls": false, "stacking": {"mode": "normal", "group": "A"}, "barAlignment": -1}, "color": {"mode": "palette-classic"}, "min": 0}, "overrides": []},
      "options": {"legend": {"showLegend": true, "displayMode": "list", "placement": "bottom", "calcs": []}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "interval": "15m",
      "targets": [{"refId": "A", "expr": "sum by (service, route, status) (increase({__name__=~\"ankilabs_(sentence_lookup|dictionary_lookup)_http_request_duration_seconds_count\",namespace=\"ankilabs\"}[$__rate_interval]))", "legendFormat": "{{service}} {{route}} {{status}}"}]
    },
    {
      "id": 9, "type": "timeseries", "title": "Lookup p95 latency",
      "description": "95th percentile request duration per lookup over a rolling 15 minutes, shown only with at least 5 requests in that window.",
      "gridPos": {"x": 12, "y": 7, "w": 12, "h": 7},
      "datasource": {"type": "prometheus", "uid": "${metrics}"},
      "fieldConfig": {"defaults": {"unit": "s", "custom": {"drawStyle": "line", "lineWidth": 1, "fillOpacity": 10, "showPoints": "never", "spanNulls": false, "stacking": {"mode": "none", "group": "A"}}, "color": {"mode": "palette-classic"}, "min": 0}, "overrides": []},
      "options": {"legend": {"showLegend": true, "displayMode": "list", "placement": "bottom", "calcs": []}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [{"refId": "A", "expr": "histogram_quantile(0.95, sum by (job, le) (increase(ankilabs_sentence_lookup_http_request_duration_seconds_bucket{namespace=\"ankilabs\"}[15m]))) and on (job) sum by (job) (increase(ankilabs_sentence_lookup_http_request_duration_seconds_count{namespace=\"ankilabs\"}[15m])) >= 5", "legendFormat": "sentence-lookup"}, {"refId": "B", "expr": "histogram_quantile(0.95, sum by (job, le) (increase(ankilabs_dictionary_lookup_http_request_duration_seconds_bucket{namespace=\"ankilabs\"}[15m]))) and on (job) sum by (job) (increase(ankilabs_dictionary_lookup_http_request_duration_seconds_count{namespace=\"ankilabs\"}[15m])) >= 5", "legendFormat": "dictionary-lookup"}]
    },
    {
      "id": 10, "type": "heatmap", "title": "sentence-lookup latency distribution",
      "description": "Completed sentence-lookup requests per latency bucket and 5-minute column.",
      "gridPos": {"x": 0, "y": 14, "w": 12, "h": 7},
      "datasource": {"type": "prometheus", "uid": "${metrics}"},
      "interval": "5m",
      "fieldConfig": {"defaults": {"custom": {"hideFrom": {"legend": false, "tooltip": false, "viz": false}, "scaleDistribution": {"type": "linear"}}}, "overrides": []},
      "options": {"calculate": false, "cellGap": 1, "cellValues": {"unit": "short"}, "color": {"mode": "scheme", "scheme": "Oranges", "fill": "dark-orange", "scale": "exponential", "exponent": 0.5, "steps": 64, "reverse": false}, "exemplars": {"color": "rgba(255,0,255,0.7)"}, "filterValues": {"le": 1e-09}, "legend": {"show": true}, "rowsFrame": {"layout": "auto"}, "showValue": "never", "tooltip": {"mode": "single", "yHistogram": false, "showColorScale": false}, "yAxis": {"axisPlacement": "left", "reverse": false, "unit": "s"}, "selectionMode": "x"},
      "targets": [{"refId": "A", "expr": "sum by (le) (increase(ankilabs_sentence_lookup_http_request_duration_seconds_bucket{namespace=\"ankilabs\"}[$__rate_interval]))", "legendFormat": "{{le}}", "format": "heatmap"}]
    },
    {
      "id": 11, "type": "heatmap", "title": "dictionary-lookup latency distribution",
      "description": "Completed dictionary-lookup requests per latency bucket and 5-minute column.",
      "gridPos": {"x": 12, "y": 14, "w": 12, "h": 7},
      "datasource": {"type": "prometheus", "uid": "${metrics}"},
      "interval": "5m",
      "fieldConfig": {"defaults": {"custom": {"hideFrom": {"legend": false, "tooltip": false, "viz": false}, "scaleDistribution": {"type": "linear"}}}, "overrides": []},
      "options": {"calculate": false, "cellGap": 1, "cellValues": {"unit": "short"}, "color": {"mode": "scheme", "scheme": "Oranges", "fill": "dark-orange", "scale": "exponential", "exponent": 0.5, "steps": 64, "reverse": false}, "exemplars": {"color": "rgba(255,0,255,0.7)"}, "filterValues": {"le": 1e-09}, "legend": {"show": true}, "rowsFrame": {"layout": "auto"}, "showValue": "never", "tooltip": {"mode": "single", "yHistogram": false, "showColorScale": false}, "yAxis": {"axisPlacement": "left", "reverse": false, "unit": "s"}, "selectionMode": "x"},
      "targets": [{"refId": "A", "expr": "sum by (le) (increase(ankilabs_dictionary_lookup_http_request_duration_seconds_bucket{namespace=\"ankilabs\"}[$__rate_interval]))", "legendFormat": "{{le}}", "format": "heatmap"}]
    },
    {
      "id": 12, "type": "row", "title": "Connection pools", "collapsed": false,
      "gridPos": {"x": 0, "y": 21, "w": 24, "h": 1},
      "panels": []
    },
    {
      "id": 13, "type": "gauge", "title": "Pool connections in use",
      "description": "Connections in use (size minus available) as a share of each pod's pool maximum. Near 100% new requests wait for a connection.",
      "gridPos": {"x": 0, "y": 22, "w": 8, "h": 7},
      "datasource": {"type": "prometheus", "uid": "${metrics}"},
      "fieldConfig": {"defaults": {"unit": "percent", "min": 0, "color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 80}, {"color": "red", "value": 90}]}, "max": 100}, "overrides": []},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "orientation": "auto", "showThresholdLabels": false, "showThresholdMarkers": true, "sizing": "auto", "minVizWidth": 75, "minVizHeight": 75},
      "targets": [{"refId": "A", "expr": "100 * (max by (pod) (ankilabs_sentence_lookup_db_pool_connections{namespace=\"ankilabs\",state=\"size\"}) - max by (pod) (ankilabs_sentence_lookup_db_pool_connections{namespace=\"ankilabs\",state=\"available\"})) / max by (pod) (ankilabs_sentence_lookup_db_pool_connections{namespace=\"ankilabs\",state=\"max\"})", "legendFormat": "{{pod}}"}, {"refId": "B", "expr": "100 * (max by (pod) (ankilabs_dictionary_lookup_db_pool_connections{namespace=\"ankilabs\",state=\"size\"}) - max by (pod) (ankilabs_dictionary_lookup_db_pool_connections{namespace=\"ankilabs\",state=\"available\"})) / max by (pod) (ankilabs_dictionary_lookup_db_pool_connections{namespace=\"ankilabs\",state=\"max\"})", "legendFormat": "{{pod}}"}]
    },
    {
      "id": 14, "type": "timeseries", "title": "Sentence pool states",
      "description": "Sentence-lookup pool per pod: size, available, waiting and max are separate states, not additive. Waiters for 3 minutes fire LookupPoolWaiting.",
      "gridPos": {"x": 8, "y": 22, "w": 8, "h": 7},
      "datasource": {"type": "prometheus", "uid": "${metrics}"},
      "fieldConfig": {"defaults": {"unit": "short", "custom": {"drawStyle": "line", "lineWidth": 1, "fillOpacity": 10, "showPoints": "never", "spanNulls": false, "stacking": {"mode": "none", "group": "A"}}, "color": {"mode": "palette-classic"}, "min": 0}, "overrides": []},
      "options": {"legend": {"showLegend": true, "displayMode": "list", "placement": "bottom", "calcs": []}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [{"refId": "A", "expr": "ankilabs_sentence_lookup_db_pool_connections{namespace=\"ankilabs\"}", "legendFormat": "{{pod}} {{state}}"}]
    },
    {
      "id": 15, "type": "timeseries", "title": "Dictionary pool states",
      "description": "Dictionary-lookup pool per pod: separate states, not additive. Waiters mean requests are queuing for a database connection (LookupPoolWaiting).",
      "gridPos": {"x": 16, "y": 22, "w": 8, "h": 7},
      "datasource": {"type": "prometheus", "uid": "${metrics}"},
      "fieldConfig": {"defaults": {"unit": "short", "custom": {"drawStyle": "line", "lineWidth": 1, "fillOpacity": 10, "showPoints": "never", "spanNulls": false, "stacking": {"mode": "none", "group": "A"}}, "color": {"mode": "palette-classic"}, "min": 0}, "overrides": []},
      "options": {"legend": {"showLegend": true, "displayMode": "list", "placement": "bottom", "calcs": []}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [{"refId": "A", "expr": "ankilabs_dictionary_lookup_db_pool_connections{namespace=\"ankilabs\"}", "legendFormat": "{{pod}} {{state}}"}]
    },
    {
      "id": 16, "type": "row", "title": "Sentence lookup stages", "collapsed": false,
      "gridPos": {"x": 0, "y": 29, "w": 24, "h": 1},
      "panels": []
    },
    {
      "id": 17, "type": "heatmap", "title": "Stage latency: $sentence_stage",
      "description": "Observations of the sentence stage picked in the Sentence stage variable, per latency bucket and 5-minute column, success and error together.",
      "gridPos": {"x": 0, "y": 30, "w": 6, "h": 8},
      "datasource": {"type": "prometheus", "uid": "${metrics}"},
      "interval": "5m",
      "fieldConfig": {"defaults": {"custom": {"hideFrom": {"legend": false, "tooltip": false, "viz": false}, "scaleDistribution": {"type": "linear"}}}, "overrides": []},
      "options": {"calculate": false, "cellGap": 1, "cellValues": {"unit": "short"}, "color": {"mode": "scheme", "scheme": "Oranges", "fill": "dark-orange", "scale": "exponential", "exponent": 0.5, "steps": 64, "reverse": false}, "exemplars": {"color": "rgba(255,0,255,0.7)"}, "filterValues": {"le": 1e-09}, "legend": {"show": true}, "rowsFrame": {"layout": "auto"}, "showValue": "never", "tooltip": {"mode": "single", "yHistogram": false, "showColorScale": false}, "yAxis": {"axisPlacement": "left", "reverse": false, "unit": "s"}, "selectionMode": "x"},
      "targets": [{"refId": "A", "expr": "sum by (le) (increase(ankilabs_sentence_lookup_stage_duration_seconds_bucket{namespace=\"ankilabs\",stage=\"$sentence_stage\"}[$__rate_interval]))", "legendFormat": "{{le}}", "format": "heatmap"}]
    },
    {
      "id": 18, "type": "timeseries", "title": "Sentence stage p95",
      "description": "95th percentile duration per stage over a rolling 15 minutes, shown only with at least 5 observations. Stages overlap: never add them into a request total.",
      "gridPos": {"x": 6, "y": 30, "w": 6, "h": 8},
      "datasource": {"type": "prometheus", "uid": "${metrics}"},
      "fieldConfig": {"defaults": {"unit": "s", "custom": {"drawStyle": "line", "lineWidth": 1, "fillOpacity": 10, "showPoints": "never", "spanNulls": false, "stacking": {"mode": "none", "group": "A"}}, "color": {"mode": "palette-classic"}, "min": 0}, "overrides": []},
      "options": {"legend": {"showLegend": true, "displayMode": "list", "placement": "bottom", "calcs": []}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [{"refId": "A", "expr": "histogram_quantile(0.95, sum by (stage, le) (increase(ankilabs_sentence_lookup_stage_duration_seconds_bucket{namespace=\"ankilabs\"}[15m]))) and on (stage) sum by (stage) (increase(ankilabs_sentence_lookup_stage_duration_seconds_count{namespace=\"ankilabs\"}[15m])) >= 5", "legendFormat": "{{stage}}"}]
    },
    {
      "id": 19, "type": "timeseries", "title": "Sentence stage mean by outcome",
      "description": "Average duration per stage and outcome over 15 minutes; read it with the sample counts beside.",
      "gridPos": {"x": 12, "y": 30, "w": 6, "h": 8},
      "datasource": {"type": "prometheus", "uid": "${metrics}"},
      "fieldConfig": {"defaults": {"unit": "s", "custom": {"drawStyle": "line", "lineWidth": 1, "fillOpacity": 10, "showPoints": "never", "spanNulls": false, "stacking": {"mode": "none", "group": "A"}}, "color": {"mode": "palette-classic"}, "min": 0}, "overrides": []},
      "options": {"legend": {"showLegend": true, "displayMode": "list", "placement": "bottom", "calcs": []}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [{"refId": "A", "expr": "sum by (stage, outcome) (increase(ankilabs_sentence_lookup_stage_duration_seconds_sum{namespace=\"ankilabs\"}[15m])) / sum by (stage, outcome) (increase(ankilabs_sentence_lookup_stage_duration_seconds_count{namespace=\"ankilabs\"}[15m]))", "legendFormat": "{{stage}} {{outcome}}"}]
    },
    {
      "id": 20, "type": "timeseries", "title": "Sentence stage observations",
      "description": "Stage observations per bar, including errors, stacked by stage and outcome. The stack counts observations, not requests; an error outcome points at the failing stage.",
      "gridPos": {"x": 18, "y": 30, "w": 6, "h": 8},
      "datasource": {"type": "prometheus", "uid": "${metrics}"},
      "fieldConfig": {"defaults": {"unit": "short", "custom": {"drawStyle": "bars", "lineWidth": 1, "fillOpacity": 80, "showPoints": "never", "spanNulls": false, "stacking": {"mode": "normal", "group": "A"}, "barAlignment": -1}, "color": {"mode": "palette-classic"}, "min": 0}, "overrides": []},
      "options": {"legend": {"showLegend": true, "displayMode": "list", "placement": "bottom", "calcs": []}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "interval": "15m",
      "targets": [{"refId": "A", "expr": "sum by (stage, outcome) (increase(ankilabs_sentence_lookup_stage_duration_seconds_count{namespace=\"ankilabs\"}[$__rate_interval]))", "legendFormat": "{{stage}} {{outcome}}"}]
    },
    {
      "id": 21, "type": "row", "title": "Dictionary lookup stages", "collapsed": false,
      "gridPos": {"x": 0, "y": 38, "w": 24, "h": 1},
      "panels": []
    },
    {
      "id": 22, "type": "heatmap", "title": "Stage latency: $dictionary_stage",
      "description": "Observations of the dictionary stage picked in the Dictionary stage variable, per latency bucket and 5-minute column, success and error together.",
      "gridPos": {"x": 0, "y": 39, "w": 6, "h": 8},
      "datasource": {"type": "prometheus", "uid": "${metrics}"},
      "interval": "5m",
      "fieldConfig": {"defaults": {"custom": {"hideFrom": {"legend": false, "tooltip": false, "viz": false}, "scaleDistribution": {"type": "linear"}}}, "overrides": []},
      "options": {"calculate": false, "cellGap": 1, "cellValues": {"unit": "short"}, "color": {"mode": "scheme", "scheme": "Oranges", "fill": "dark-orange", "scale": "exponential", "exponent": 0.5, "steps": 64, "reverse": false}, "exemplars": {"color": "rgba(255,0,255,0.7)"}, "filterValues": {"le": 1e-09}, "legend": {"show": true}, "rowsFrame": {"layout": "auto"}, "showValue": "never", "tooltip": {"mode": "single", "yHistogram": false, "showColorScale": false}, "yAxis": {"axisPlacement": "left", "reverse": false, "unit": "s"}, "selectionMode": "x"},
      "targets": [{"refId": "A", "expr": "sum by (le) (increase(ankilabs_dictionary_lookup_stage_duration_seconds_bucket{namespace=\"ankilabs\",stage=\"$dictionary_stage\"}[$__rate_interval]))", "legendFormat": "{{le}}", "format": "heatmap"}]
    },
    {
      "id": 23, "type": "timeseries", "title": "Dictionary stage p95",
      "description": "95th percentile duration per stage over a rolling 15 minutes, shown only with at least 5 observations. Stages overlap: never add them into a request total.",
      "gridPos": {"x": 6, "y": 39, "w": 6, "h": 8},
      "datasource": {"type": "prometheus", "uid": "${metrics}"},
      "fieldConfig": {"defaults": {"unit": "s", "custom": {"drawStyle": "line", "lineWidth": 1, "fillOpacity": 10, "showPoints": "never", "spanNulls": false, "stacking": {"mode": "none", "group": "A"}}, "color": {"mode": "palette-classic"}, "min": 0}, "overrides": []},
      "options": {"legend": {"showLegend": true, "displayMode": "list", "placement": "bottom", "calcs": []}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [{"refId": "A", "expr": "histogram_quantile(0.95, sum by (stage, le) (increase(ankilabs_dictionary_lookup_stage_duration_seconds_bucket{namespace=\"ankilabs\"}[15m]))) and on (stage) sum by (stage) (increase(ankilabs_dictionary_lookup_stage_duration_seconds_count{namespace=\"ankilabs\"}[15m])) >= 5", "legendFormat": "{{stage}}"}]
    },
    {
      "id": 24, "type": "timeseries", "title": "Dictionary stage mean by outcome",
      "description": "Average duration per stage and outcome over 15 minutes; read it with the sample counts beside.",
      "gridPos": {"x": 12, "y": 39, "w": 6, "h": 8},
      "datasource": {"type": "prometheus", "uid": "${metrics}"},
      "fieldConfig": {"defaults": {"unit": "s", "custom": {"drawStyle": "line", "lineWidth": 1, "fillOpacity": 10, "showPoints": "never", "spanNulls": false, "stacking": {"mode": "none", "group": "A"}}, "color": {"mode": "palette-classic"}, "min": 0}, "overrides": []},
      "options": {"legend": {"showLegend": true, "displayMode": "list", "placement": "bottom", "calcs": []}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [{"refId": "A", "expr": "sum by (stage, outcome) (increase(ankilabs_dictionary_lookup_stage_duration_seconds_sum{namespace=\"ankilabs\"}[15m])) / sum by (stage, outcome) (increase(ankilabs_dictionary_lookup_stage_duration_seconds_count{namespace=\"ankilabs\"}[15m]))", "legendFormat": "{{stage}} {{outcome}}"}]
    },
    {
      "id": 25, "type": "timeseries", "title": "Dictionary stage observations",
      "description": "Stage observations per bar, including errors, stacked by stage and outcome. The stack counts observations, not requests; an error outcome points at the failing stage.",
      "gridPos": {"x": 18, "y": 39, "w": 6, "h": 8},
      "datasource": {"type": "prometheus", "uid": "${metrics}"},
      "fieldConfig": {"defaults": {"unit": "short", "custom": {"drawStyle": "bars", "lineWidth": 1, "fillOpacity": 80, "showPoints": "never", "spanNulls": false, "stacking": {"mode": "normal", "group": "A"}, "barAlignment": -1}, "color": {"mode": "palette-classic"}, "min": 0}, "overrides": []},
      "options": {"legend": {"showLegend": true, "displayMode": "list", "placement": "bottom", "calcs": []}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "interval": "15m",
      "targets": [{"refId": "A", "expr": "sum by (stage, outcome) (increase(ankilabs_dictionary_lookup_stage_duration_seconds_count{namespace=\"ankilabs\"}[$__rate_interval]))", "legendFormat": "{{stage}} {{outcome}}"}]
    },
    {
      "id": 26, "type": "row", "title": "Search rows", "collapsed": false,
      "gridPos": {"x": 0, "y": 47, "w": 24, "h": 1},
      "panels": []
    },
    {
      "id": 27, "type": "heatmap", "title": "Search rows distribution: $phase",
      "description": "Searches per row-count bucket and 5-minute column for the phase picked in the Search phase variable. These are per-phase observations, not SQL execution plans.",
      "gridPos": {"x": 0, "y": 48, "w": 8, "h": 7},
      "datasource": {"type": "prometheus", "uid": "${metrics}"},
      "interval": "5m",
      "fieldConfig": {"defaults": {"custom": {"hideFrom": {"legend": false, "tooltip": false, "viz": false}, "scaleDistribution": {"type": "linear"}}}, "overrides": []},
      "options": {"calculate": false, "cellGap": 1, "cellValues": {"unit": "short"}, "color": {"mode": "scheme", "scheme": "Oranges", "fill": "dark-orange", "scale": "exponential", "exponent": 0.5, "steps": 64, "reverse": false}, "exemplars": {"color": "rgba(255,0,255,0.7)"}, "filterValues": {"le": 1e-09}, "legend": {"show": true}, "rowsFrame": {"layout": "auto"}, "showValue": "never", "tooltip": {"mode": "single", "yHistogram": false, "showColorScale": false}, "yAxis": {"axisPlacement": "left", "reverse": false, "unit": "short"}, "selectionMode": "x"},
      "targets": [{"refId": "A", "expr": "sum by (le) (increase(ankilabs_sentence_lookup_search_rows_bucket{namespace=\"ankilabs\",phase=\"$phase\"}[$__rate_interval]))", "legendFormat": "{{le}}", "format": "heatmap"}]
    },
    {
      "id": 28, "type": "timeseries", "title": "Mean rows per search phase",
      "description": "Average rows per search phase over 15 minutes; candidate, matched and returned are distinct phases and not every request reaches each.",
      "gridPos": {"x": 8, "y": 48, "w": 8, "h": 7},
      "datasource": {"type": "prometheus", "uid": "${metrics}"},
      "fieldConfig": {"defaults": {"unit": "short", "custom": {"drawStyle": "line", "lineWidth": 1, "fillOpacity": 10, "showPoints": "never", "spanNulls": false, "stacking": {"mode": "none", "group": "A"}}, "color": {"mode": "palette-classic"}, "min": 0}, "overrides": []},
      "options": {"legend": {"showLegend": true, "displayMode": "list", "placement": "bottom", "calcs": []}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [{"refId": "A", "expr": "sum by (phase) (increase(ankilabs_sentence_lookup_search_rows_sum{namespace=\"ankilabs\"}[15m])) / sum by (phase) (increase(ankilabs_sentence_lookup_search_rows_count{namespace=\"ankilabs\"}[15m]))", "legendFormat": "{{phase}}"}]
    },
    {
      "id": 29, "type": "timeseries", "title": "Searches per phase",
      "description": "Searches observed per phase and bar; how many searches the mean rows beside represent. Phases are not stacked: they describe the same searches.",
      "gridPos": {"x": 16, "y": 48, "w": 8, "h": 7},
      "datasource": {"type": "prometheus", "uid": "${metrics}"},
      "fieldConfig": {"defaults": {"unit": "short", "custom": {"drawStyle": "bars", "lineWidth": 1, "fillOpacity": 80, "showPoints": "never", "spanNulls": false, "stacking": {"mode": "none", "group": "A"}, "barAlignment": -1}, "color": {"mode": "palette-classic"}, "min": 0}, "overrides": []},
      "options": {"legend": {"showLegend": true, "displayMode": "list", "placement": "bottom", "calcs": []}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "interval": "15m",
      "targets": [{"refId": "A", "expr": "sum by (phase) (increase(ankilabs_sentence_lookup_search_rows_count{namespace=\"ankilabs\"}[$__rate_interval]))", "legendFormat": "{{phase}}"}]
    },
    {
      "id": 30, "type": "row", "title": "PostgreSQL", "collapsed": false,
      "gridPos": {"x": 0, "y": 55, "w": 24, "h": 1},
      "panels": []
    },
    {
      "id": 31, "type": "state-timeline", "title": "Exporter connection and collectors",
      "description": "pg_up and every enabled collector over time: green OK, red failed, gap unknown. PostgreSQLUnavailable and PostgreSQLCollectorFailure alert on them.",
      "gridPos": {"x": 0, "y": 56, "w": 12, "h": 6},
      "datasource": {"type": "prometheus", "uid": "${metrics}"},
      "fieldConfig": {"defaults": {"unit": "short", "color": {"mode": "fixed", "fixedColor": "blue"}, "mappings": [{"type": "value", "options": {"0": {"text": "Failed", "color": "red", "index": 0}, "1": {"text": "OK", "color": "green", "index": 1}}}], "custom": {"lineWidth": 0, "fillOpacity": 75}}, "overrides": []},
      "options": {"showValue": "auto", "rowHeight": 0.85, "mergeValues": true, "alignValue": "left", "legend": {"showLegend": false, "displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "single", "sort": "none"}},
      "targets": [{"refId": "A", "expr": "max(pg_up{namespace=\"ankilabs\"})", "legendFormat": "connection (pg_up)"}, {"refId": "B", "expr": "max by (collector) (pg_scrape_collector_success{namespace=\"ankilabs\"})", "legendFormat": "{{collector}}"}]
    },
    {
      "id": 32, "type": "gauge", "title": "Connections used",
      "description": "Backends in every database as a share of max_connections. The ceiling includes reserved capacity, so lookups cannot use all of it.",
      "gridPos": {"x": 12, "y": 56, "w": 4, "h": 6},
      "datasource": {"type": "prometheus", "uid": "${metrics}"},
      "fieldConfig": {"defaults": {"unit": "percent", "min": 0, "color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 80}, {"color": "red", "value": 90}]}, "max": 100}, "overrides": []},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "orientation": "auto", "showThresholdLabels": false, "showThresholdMarkers": true, "sizing": "auto", "minVizWidth": 75, "minVizHeight": 75},
      "targets": [{"refId": "A", "expr": "100 * sum(pg_stat_database_numbackends{namespace=\"ankilabs\"}) / max(pg_settings_max_connections{namespace=\"ankilabs\"})", "legendFormat": "connections"}]
    },
    {
      "id": 33, "type": "gauge", "title": "Cache hit ratio",
      "description": "Share of ankilabs block reads served from shared buffers over 15 minutes. Below 99% reads go to disk; empty when the database was idle.",
      "gridPos": {"x": 16, "y": 56, "w": 4, "h": 6},
      "datasource": {"type": "prometheus", "uid": "${metrics}"},
      "fieldConfig": {"defaults": {"unit": "percent", "min": 0, "color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "orange", "value": 90}, {"color": "green", "value": 99}]}, "max": 100, "decimals": 1}, "overrides": []},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "orientation": "auto", "showThresholdLabels": false, "showThresholdMarkers": true, "sizing": "auto", "minVizWidth": 75, "minVizHeight": 75},
      "targets": [{"refId": "A", "expr": "100 * sum(increase(pg_stat_database_blks_hit{namespace=\"ankilabs\",datname=\"ankilabs\"}[15m])) / (sum(increase(pg_stat_database_blks_hit{namespace=\"ankilabs\",datname=\"ankilabs\"}[15m])) + sum(increase(pg_stat_database_blks_read{namespace=\"ankilabs\",datname=\"ankilabs\"}[15m])) > 0)", "legendFormat": "cache hit"}]
    },
    {
      "id": 34, "type": "stat", "title": "Database size",
      "description": "On-disk size of the ankilabs database; the sparkline shows growth.",
      "gridPos": {"x": 20, "y": 56, "w": 4, "h": 6},
      "datasource": {"type": "prometheus", "uid": "${metrics}"},
      "fieldConfig": {"defaults": {"unit": "bytes", "color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [{"color": "blue", "value": null}]}, "mappings": []}, "overrides": []},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "orientation": "auto", "textMode": "auto", "colorMode": "value", "graphMode": "area", "justifyMode": "auto", "wideLayout": true, "showPercentChange": false},
      "targets": [{"refId": "A", "expr": "pg_database_size_bytes{namespace=\"ankilabs\",datname=\"ankilabs\"}", "legendFormat": "ankilabs"}]
    },
    {
      "id": 35, "type": "timeseries", "title": "Client connections by state and wait type",
      "description": "Client connections to the ankilabs database by state and wait type, stacked to the total. Many idle-in-transaction or lock waits point at stuck requests; compare with the lookup pools.",
      "gridPos": {"x": 0, "y": 62, "w": 12, "h": 7},
      "datasource": {"type": "prometheus", "uid": "${metrics}"},
      "fieldConfig": {"defaults": {"unit": "short", "custom": {"drawStyle": "line", "lineWidth": 1, "fillOpacity": 10, "showPoints": "never", "spanNulls": false, "stacking": {"mode": "normal", "group": "A"}}, "color": {"mode": "palette-classic"}, "min": 0}, "overrides": []},
      "options": {"legend": {"showLegend": true, "displayMode": "list", "placement": "bottom", "calcs": []}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [{"refId": "A", "expr": "sum by (state, wait_event_type) (pg_stat_activity_count{namespace=\"ankilabs\",datname=\"ankilabs\",backend_type=\"client backend\"})", "legendFormat": "{{state}} {{wait_event_type}}"}]
    },
    {
      "id": 36, "type": "timeseries", "title": "Database backends and server connection ceiling",
      "description": "ankilabs backends against the server-wide max_connections, which includes reserved capacity.",
      "gridPos": {"x": 12, "y": 62, "w": 12, "h": 7},
      "datasource": {"type": "prometheus", "uid": "${metrics}"},
      "fieldConfig": {"defaults": {"unit": "short", "custom": {"drawStyle": "line", "lineWidth": 1, "fillOpacity": 10, "showPoints": "never", "spanNulls": false, "stacking": {"mode": "none", "group": "A"}}, "color": {"mode": "palette-classic"}, "min": 0}, "overrides": []},
      "options": {"legend": {"showLegend": true, "displayMode": "list", "placement": "bottom", "calcs": []}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [{"refId": "A", "expr": "pg_stat_database_numbackends{namespace=\"ankilabs\",datname=\"ankilabs\"}", "legendFormat": "ankilabs backends"}, {"refId": "B", "expr": "pg_settings_max_connections{namespace=\"ankilabs\"}", "legendFormat": "server max_connections"}]
    },
    {
      "id": 37, "type": "timeseries", "title": "Oldest transaction by state",
      "description": "Age of the oldest open transaction per state. A steadily growing value, especially idle in transaction, means a session holds a transaction open; find its PID in the PostgreSQL logs.",
      "gridPos": {"x": 0, "y": 69, "w": 12, "h": 7},
      "datasource": {"type": "prometheus", "uid": "${metrics}"},
      "fieldConfig": {"defaults": {"unit": "s", "custom": {"drawStyle": "line", "lineWidth": 1, "fillOpacity": 10, "showPoints": "never", "spanNulls": false, "stacking": {"mode": "none", "group": "A"}}, "color": {"mode": "palette-classic"}, "min": 0}, "overrides": []},
      "options": {"legend": {"showLegend": true, "displayMode": "list", "placement": "bottom", "calcs": []}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [{"refId": "A", "expr": "max by (state) (pg_stat_activity_max_tx_duration{namespace=\"ankilabs\",datname=\"ankilabs\"})", "legendFormat": "{{state}}"}]
    },
    {
      "id": 38, "type": "timeseries", "title": "Locks by mode",
      "description": "Locks held in the ankilabs database by mode: held locks, not blocked requests. Check the oldest transaction and wait types when they climb.",
      "gridPos": {"x": 12, "y": 69, "w": 12, "h": 7},
      "datasource": {"type": "prometheus", "uid": "${metrics}"},
      "fieldConfig": {"defaults": {"unit": "short", "custom": {"drawStyle": "line", "lineWidth": 1, "fillOpacity": 10, "showPoints": "never", "spanNulls": false, "stacking": {"mode": "none", "group": "A"}}, "color": {"mode": "palette-classic"}, "min": 0}, "overrides": []},
      "options": {"legend": {"showLegend": true, "displayMode": "list", "placement": "bottom", "calcs": []}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [{"refId": "A", "expr": "sum by (mode) (pg_locks_count{namespace=\"ankilabs\",datname=\"ankilabs\"})", "legendFormat": "{{mode}}"}]
    },
    {
      "id": 39, "type": "timeseries", "title": "Commits and rollbacks",
      "description": "Transactions per bar, stacked to the total. A rollback is not necessarily a user-visible error; correlate with request outcomes and SQLSTATE.",
      "gridPos": {"x": 0, "y": 76, "w": 8, "h": 7},
      "datasource": {"type": "prometheus", "uid": "${metrics}"},
      "fieldConfig": {"defaults": {"unit": "short", "custom": {"drawStyle": "bars", "lineWidth": 1, "fillOpacity": 80, "showPoints": "never", "spanNulls": false, "stacking": {"mode": "normal", "group": "A"}, "barAlignment": -1}, "color": {"mode": "palette-classic"}, "min": 0}, "overrides": []},
      "options": {"legend": {"showLegend": true, "displayMode": "list", "placement": "bottom", "calcs": []}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "interval": "15m",
      "targets": [{"refId": "A", "expr": "increase(pg_stat_database_xact_commit{namespace=\"ankilabs\",datname=\"ankilabs\"}[$__rate_interval])", "legendFormat": "commits"}, {"refId": "B", "expr": "increase(pg_stat_database_xact_rollback{namespace=\"ankilabs\",datname=\"ankilabs\"}[$__rate_interval])", "legendFormat": "rollbacks"}]
    },
    {
      "id": 40, "type": "timeseries", "title": "Checkpoints",
      "description": "Scheduled and requested checkpoints per bar, from pg_stat_checkpointer (PostgreSQL 17+). Frequent requested checkpoints mean heavy writes.",
      "gridPos": {"x": 8, "y": 76, "w": 8, "h": 7},
      "datasource": {"type": "prometheus", "uid": "${metrics}"},
      "fieldConfig": {"defaults": {"unit": "short", "custom": {"drawStyle": "bars", "lineWidth": 1, "fillOpacity": 80, "showPoints": "never", "spanNulls": false, "stacking": {"mode": "normal", "group": "A"}, "barAlignment": -1}, "color": {"mode": "palette-classic"}, "min": 0}, "overrides": []},
      "options": {"legend": {"showLegend": true, "displayMode": "list", "placement": "bottom", "calcs": []}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "interval": "15m",
      "targets": [{"refId": "A", "expr": "increase(pg_stat_checkpointer_num_timed_total{namespace=\"ankilabs\"}[$__rate_interval])", "legendFormat": "scheduled"}, {"refId": "B", "expr": "increase(pg_stat_checkpointer_num_requested_total{namespace=\"ankilabs\"}[$__rate_interval])", "legendFormat": "requested"}]
    },
    {
      "id": 41, "type": "gauge", "title": "PostgreSQL volume used",
      "description": "Kubelet-reported used bytes of data-postgres-0 against its capacity. On openebs-hostpath both may be the whole node filesystem; Platform - Storage has the authoritative view.",
      "gridPos": {"x": 16, "y": 76, "w": 8, "h": 7},
      "datasource": {"type": "prometheus", "uid": "${metrics}"},
      "fieldConfig": {"defaults": {"unit": "bytes", "min": 0, "color": {"mode": "thresholds"}, "thresholds": {"mode": "percentage", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 80}, {"color": "red", "value": 90}]}}, "overrides": []},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "orientation": "auto", "showThresholdLabels": false, "showThresholdMarkers": true, "sizing": "auto", "minVizWidth": 75, "minVizHeight": 75},
      "transformations": [{"id": "configFromData", "options": {"configRefId": "B", "mappings": [{"fieldName": "capacity", "handlerKey": "max"}]}}],
      "targets": [{"refId": "A", "expr": "max(kubelet_volume_stats_used_bytes{namespace=\"ankilabs\",persistentvolumeclaim=\"data-postgres-0\"})", "legendFormat": "used"}, {"refId": "B", "expr": "max(kubelet_volume_stats_capacity_bytes{namespace=\"ankilabs\",persistentvolumeclaim=\"data-postgres-0\"})", "legendFormat": "capacity"}]
    },
    {
      "id": 42, "type": "row", "title": "Logs", "collapsed": true,
      "gridPos": {"x": 0, "y": 83, "w": 24, "h": 1},
      "panels": [
        {
          "id": 43, "type": "logs", "title": "Lookup breadcrumbs by request ID / fingerprint",
          "description": "Sentence and dictionary lookup events filtered by the request_id and fingerprint variables (parsed at query time, never indexed). Started events show the last stage reached when a process died.",
          "gridPos": {"x": 0, "y": 84, "w": 24, "h": 10},
          "datasource": {"type": "loki", "uid": "${logs}"},
          "options": {"showTime": true, "wrapLogMessage": true, "sortOrder": "Descending"},
          "targets": [{"refId": "A", "expr": "{namespace=\"ankilabs\",app=~\"sentence-lookup|dictionary-lookup\"} | json | request_id=~`.*${request_id:regex}.*` | query_fingerprint=~`.*${fingerprint:regex}.*`"}]
        },
        {
          "id": 44, "type": "logs", "title": "PostgreSQL stderr: native severity, normalized level and raw fallback",
          "description": "EOF with an open transaction retains pg_severity=LOG and gets level=WARNING. PID is query-time only; correlate within a narrow time range because PIDs can be reused.",
          "gridPos": {"x": 0, "y": 94, "w": 24, "h": 10},
          "datasource": {"type": "loki", "uid": "${logs}"},
          "options": {"showTime": true, "wrapLogMessage": true, "sortOrder": "Descending"},
          "targets": [{"refId": "A", "expr": "{namespace=\"ankilabs\",app=\"postgres\",container=\"postgres\"} | json | db_backend_pid=~`.*${backend_pid:regex}.*`"}]
        }
      ]
    }
  ]
}
