      "targets": [
        {
          "datasource": "${DS_LOKI}",
          "expr": "{namespace=~\"$namespace\"} !~ \"(?i)(health|healthz|readyz|livez|version)\" |= \"$search\"",
          "refId": "A"
        }
      ],
      "title": "Live application flow logs",
      "type": "logs"
    }
