        "tooltip": { "mode": "single", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": "${DS_LOKI}",
          "expr": "sum by (namespace) (count_over_time({namespace=~\"$namespace\"} |= \"$search\" [$__interval]))",
          "legendFormat": "{{namespace}}",
          "refId": "A"
        }
      ],
      "title": "Log volume by namespace",
      "type": "timeseries"
    },
    {
      "datasource": "${DS_LOKI}",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 25 },
              { "color": "red", "value": 50 }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "id": 2,
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "center",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "value_and_name"
      },
      "targets": [
        {
          "datasource": "${DS_LOKI}",
          "expr": "sum by (namespace) (count_over_time({namespace=~\"$namespace\"} |~ \"(?i)(error|fatal|panic|exception|traceback|crash|oom)\" [$__interval]))",
          "legendFormat": "{{namespace}}",
          "refId": "A"
        }
      ],
      "title": "Error volume by namespace",
      "type": "stat"
    },
    {
      "datasource": "${DS_LOKI}",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 8 },
      "id": 3,
      "options": {
        "dedupStrategy": "numbers",
        "enableLogDetails": true,
        "prettifyLogMessage": true,
        "showCommonLabels": false,
        "showLabels": false,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      },
      "targets": [
        {
          "datasource": "${DS_LOKI}",
          "expr": "{namespace=~\"$namespace\"} |~ \"(?i)(error|fatal|panic|exception|traceback|crash|oom|failed|timeout|unhealthy|not ready)\" !~ \"(?i)(health|healthz|readyz|livez|version)\" |= \"$search\"",
          "refId": "A"
        }
      ],
      "title": "Recent errors and failures",
      "type": "logs"
    },
    {
      "datasource": "${DS_LOKI}",
