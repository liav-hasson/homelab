{
  "uid": "ankilabs-service-health",
  "title": "AnkiLabs - Service Health",
  "description": "AnkiLabs request rate, errors and latency per service, gateway-to-lookup calls, availability and resources. Failures are observed 5xx or explicit upstream timeout/unavailable; percentiles need at least 5 requests.",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "graphTooltip": 1,
  "tags": ["homelab-monitoring", "ankilabs", "services"],
  "timezone": "browser",
  "refresh": "30s",
  "time": {"from": "now-6h", "to": "now"},
  "links": [
    {"type": "link", "title": "Runbook", "tooltip": "How to read this dashboard", "url": "https://github.com/liav-hasson/homelab/blob/main/k8s/platform/monitoring/runbook.md#ankilabs-service-health", "icon": "doc", "targetBlank": true},
    {"type": "dashboards", "tags": ["homelab-monitoring"], "title": "Monitoring", "asDropdown": true, "keepTime": true, "includeVars": true}
  ],
  "templating": {"list": [{"name": "metrics", "label": "Prometheus", "type": "datasource", "query": "prometheus"}, {"name": "logs", "label": "Loki", "type": "datasource", "query": "loki"}, {"name": "request_id", "label": "Request ID contains (query-time only)", "type": "textbox", "query": "", "current": {"text": "", "value": ""}}]},
  "panels": [
    {
      "id": 1, "type": "row", "title": "At a glance", "collapsed": false,
      "gridPos": {"x": 0, "y": 0, "w": 24, "h": 1},
      "panels": []
    },
    {
      "id": 2, "type": "stat", "title": "Requests (15 min)",
      "description": "Completed HTTP requests per service in the last 15 minutes; the sparkline is the same rolling count.",
      "gridPos": {"x": 0, "y": 1, "w": 5, "h": 5},
      "datasource": {"type": "prometheus", "uid": "${metrics}"},
      "fieldConfig": {"defaults": {"unit": "short", "color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [{"color": "blue", "value": null}]}, "mappings": [], "decimals": 0}, "overrides": []},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "orientation": "auto", "textMode": "value_and_name", "colorMode": "value", "graphMode": "area", "justifyMode": "auto", "wideLayout": true, "showPercentChange": false},
      "targets": [{"refId": "A", "expr": "sum(increase(ankilabs_api_gateway_http_request_duration_seconds_count{namespace=\"ankilabs\"}[15m]))", "legendFormat": "api-gateway"}, {"refId": "B", "expr": "sum(increase(ankilabs_sentence_lookup_http_request_duration_seconds_count{namespace=\"ankilabs\"}[15m]))", "legendFormat": "sentence-lookup"}, {"refId": "C", "expr": "sum(increase(ankilabs_dictionary_lookup_http_request_duration_seconds_count{namespace=\"ankilabs\"}[15m]))", "legendFormat": "dictionary-lookup"}]
    },
    {
      "id": 3, "type": "stat", "title": "5xx share (15 min)",
      "description": "Share of completed requests that returned 5xx in the last 15 minutes. Empty without traffic; any 5xx fires AnkiLabsRequestFailure.",
      "gridPos": {"x": 5, "y": 1, "w": 5, "h": 5},
      "datasource": {"type": "prometheus", "uid": "${metrics}"},
      "fieldConfig": {"defaults": {"unit": "percent", "color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 0.001}, {"color": "red", "value": 5}]}, "mappings": [], "decimals": 1}, "overrides": []},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "orientation": "auto", "textMode": "value_and_name", "colorMode": "value", "graphMode": "area", "justifyMode": "auto", "wideLayout": true, "showPercentChange": false},
      "targets": [{"refId": "A", "expr": "100 * (sum(increase(ankilabs_api_gateway_http_request_duration_seconds_count{namespace=\"ankilabs\",status=~\"5..\"}[15m])) or sum(increase(ankilabs_api_gateway_http_request_duration_seconds_count{namespace=\"ankilabs\"}[15m])) * 0) / (sum(increase(ankilabs_api_gateway_http_request_duration_seconds_count{namespace=\"ankilabs\"}[15m])) > 0)", "legendFormat": "api-gateway"}, {"refId": "B", "expr": "100 * (sum(increase(ankilabs_sentence_lookup_http_request_duration_seconds_count{namespace=\"ankilabs\",status=~\"5..\"}[15m])) or sum(increase(ankilabs_sentence_lookup_http_request_duration_seconds_count{namespace=\"ankilabs\"}[15m])) * 0) / (sum(increase(ankilabs_sentence_lookup_http_request_duration_seconds_count{namespace=\"ankilabs\"}[15m])) > 0)", "legendFormat": "sentence-lookup"}, {"refId": "C", "expr": "100 * (sum(increase(ankilabs_dictionary_lookup_http_request_duration_seconds_count{namespace=\"ankilabs\",status=~\"5..\"}[15m])) or sum(increase(ankilabs_dictionary_lookup_http_request_duration_seconds_count{namespace=\"ankilabs\"}[15m])) * 0) / (sum(increase(ankilabs_dictionary_lookup_http_request_duration_seconds_count{namespace=\"ankilabs\"}[15m])) > 0)", "legendFormat": "dictionary-lookup"}]
    },
    {
      "id": 4, "type": "stat", "title": "p95 latency (15 min)",
      "description": "95th percentile request duration per service over 15 minutes, shown only with at least 5 requests in that window.",
      "gridPos": {"x": 10, "y": 1, "w": 6, "h": 5},
      "datasource": {"type": "prometheus", "uid": "${metrics}"},
      "fieldConfig": {"defaults": {"unit": "s", "color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 1}, {"color": "red", "value": 5}]}, "mappings": []}, "overrides": []},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "orientation": "auto", "textMode": "value_and_name", "colorMode": "value", "graphMode": "area", "justifyMode": "auto", "wideLayout": true, "showPercentChange": false},
      "targets": [{"refId": "A", "expr": "histogram_quantile(0.95, sum by (job, le) (increase(ankilabs_api_gateway_http_request_duration_seconds_bucket{namespace=\"ankilabs\"}[15m]))) and on (job) sum by (job) (increase(ankilabs_api_gateway_http_request_duration_seconds_count{namespace=\"ankilabs\"}[15m])) >= 5", "legendFormat": "api-gateway"}, {"refId": "B", "expr": "histogram_quantile(0.95, sum by (job, le) (increase(ankilabs_sentence_lookup_http_request_duration_seconds_bucket{namespace=\"ankilabs\"}[15m]))) and on (job) sum by (job) (increase(ankilabs_sentence_lookup_http_request_duration_seconds_count{namespace=\"ankilabs\"}[15m])) >= 5", "legendFormat": "sentence-lookup"}, {"refId": "C", "expr": "histogram_quantile(0.95, sum by (job, le) (increase(ankilabs_dictionary_lookup_http_request_duration_seconds_bucket{namespace=\"ankilabs\"}[15m]))) and on (job) sum by (job) (increase(ankilabs_dictionary_lookup_http_request_duration_seconds_count{namespace=\"ankilabs\"}[15m])) >= 5", "legendFormat": "dictionary-lookup"}]
    },
    {
      "id": 5, "type": "stat", "title": "Upstream failures",
      "description": "Gateway calls to the lookups that ended 5xx, timeout or unavailable in the last 15 minutes (AnkiLabsUpstreamFailure).",
      "gridPos": {"x": 16, "y": 1, "w": 4, "h": 5},
      "datasource": {"type": "prometheus", "uid": "${metrics}"},
      "fieldConfig": {"defaults": {"unit": "short", "color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 1}]}, "mappings": [], "decimals": 0}, "overrides": []},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "orientation": "auto", "textMode": "auto", "colorMode": "value", "graphMode": "area", "justifyMode": "auto", "wideLayout": true, "showPercentChange": false},
      "targets": [{"refId": "A", "expr": "sum(increase(ankilabs_api_gateway_upstream_request_duration_seconds_count{namespace=\"ankilabs\",service=~\"Sentence Lookup|Dictionary Lookup\",status=~\"5..|timeout|unavailable\"}[15m])) or sum(increase(ankilabs_api_gateway_upstream_request_duration_seconds_count{namespace=\"ankilabs\",service=~\"Sentence Lookup|Dictionary Lookup\"}[15m])) * 0", "legendFormat": "failures"}]
    },
    {
      "id": 6, "type": "stat", "title": "Scrape targets",
      "description": "Gateway, lookups, PostgreSQL exporter and AI Card Actions targets reachable and failed. AnkiLabsExpectedTargetMissing covers targets that vanished.",
      "gridPos": {"x": 20, "y": 1, "w": 4, "h": 5},
      "datasource": {"type": "prometheus", "uid": "${metrics}"},
      "fieldConfig": {"defaults": {"unit": "short", "color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [{"color": "blue", "value": null}]}, "mappings": []}, "overrides": [{"matcher": {"id": "byName", "options": "down"}, "properties": [{"id": "thresholds", "value": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 1}]}}]}]},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "orientation": "auto", "textMode": "value_and_name", "colorMode": "value", "graphMode": "area", "justifyMode": "auto", "wideLayout": true, "showPercentChange": false},
      "targets": [{"refId": "A", "expr": "sum(up{namespace=\"ankilabs\",job=~\"monitoring/(ankilabs-api-gateway|ankilabs-lookups|ankilabs-postgres|ankilabs-ai-card-actions)\"})", "legendFormat": "up"}, {"refId": "B", "expr": "count(up{namespace=\"ankilabs\",job=~\"monitoring/(ankilabs-api-gateway|ankilabs-lookups|ankilabs-postgres|ankilabs-ai-card-actions)\"} == 0) or count(up{namespace=\"ankilabs\",job=~\"monitoring/(ankilabs-api-gateway|ankilabs-lookups|ankilabs-postgres|ankilabs-ai-card-actions)\"}) * 0", "legendFormat": "down"}]
    },
    {
      "id": 7, "type": "state-timeline", "title": "Scrape health",
      "description": "Each AnkiLabs metrics target over time. A gap is unknown, not healthy; AnkiLabsScrapeFailed and AnkiLabsExpectedTargetMissing alert on both.",
      "gridPos": {"x": 0, "y": 6, "w": 12, "h": 7},
      "datasource": {"type": "prometheus", "uid": "${metrics}"},
      "fieldConfig": {"defaults": {"unit": "short", "color": {"mode": "fixed", "fixedColor": "blue"}, "mappings": [{"type": "value", "options": {"0": {"text": "Down", "color": "red", "index": 0}, "1": {"text": "Up", "color": "green", "index": 1}}}], "custom": {"lineWidth": 0, "fillOpacity": 75}}, "overrides": []},
      "options": {"showValue": "auto", "rowHeight": 0.85, "mergeValues": true, "alignValue": "left", "legend": {"showLegend": false, "displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "single", "sort": "none"}},
      "targets": [{"refId": "A", "expr": "up{namespace=\"ankilabs\",job=~\"monitoring/(ankilabs-api-gateway|ankilabs-lookups|ankilabs-postgres|ankilabs-ai-card-actions)\"}", "legendFormat": "{{pod}}"}]
    },
    {
      "id": 8, "type": "state-timeline", "title": "Deployment availability",
      "description": "Available over desired replicas per AnkiLabs Deployment, from Kubernetes readiness. Red below 100%: check restarts, OOM kills and the warning logs.",
      "gridPos": {"x": 12, "y": 6, "w": 12, "h": 7},
      "datasource": {"type": "prometheus", "uid": "${metrics}"},
      "fieldConfig": {"defaults": {"unit": "percentunit", "color": {"mode": "fixed", "fixedColor": "blue"}, "mappings": [{"type": "range", "options": {"result": {"color": "green", "index": 0}, "from": 1}}, {"type": "range", "options": {"result": {"color": "red", "index": 1}, "to": 0.9999}}], "custom": {"lineWidth": 0, "fillOpacity": 75}}, "overrides": []},
      "options": {"showValue": "auto", "rowHeight": 0.85, "mergeValues": true, "alignValue": "left", "legend": {"showLegend": false, "displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "single", "sort": "none"}},
      "targets": [{"refId": "A", "expr": "kube_deployment_status_replicas_available{namespace=\"ankilabs\"} / on (namespace, deployment) kube_deployment_spec_replicas{namespace=\"ankilabs\"}", "legendFormat": "{{deployment}}"}]
    },
    {
      "id": 9, "type": "row", "title": "Requests", "collapsed": false,
      "gridPos": {"x": 0, "y": 13, "w": 24, "h": 1},
      "panels": []
    },
    {
      "id": 10, "type": "timeseries", "title": "Completed requests by service, route and status",
      "description": "Completed HTTP requests per bar (15 minutes, longer on wide ranges), stacked to the total. Counts come from counter increases and can be fractional; they are not an audit log.",
      "gridPos": {"x": 0, "y": 14, "w": 16, "h": 8},
      "datasource": {"type": "prometheus", "uid": "${metrics}"},
      "fieldConfig": {"defaults": {"unit": "short", "custom": {"drawStyle": "bars", "lineWidth": 1, "fillOpacity": 80, "showPoints": "never", "spanNulls": false, "stacking": {"mode": "normal", "group": "A"}, "barAlignment": -1}, "color": {"mode": "palette-classic"}, "min": 0}, "overrides": []},
      "options": {"legend": {"showLegend": true, "displayMode": "list", "placement": "bottom", "calcs": []}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "interval": "15m",
      "targets": [{"refId": "A", "expr": "label_replace(sum by (job, service, route, status) (increase({__name__=~\"ankilabs_(api_gateway|sentence_lookup|dictionary_lookup)_http_request_duration_seconds_count\",namespace=\"ankilabs\"}[$__rate_interval])), \"service\", \"api-gateway\", \"job\", \"monitoring/ankilabs-api-gateway\")", "legendFormat": "{{service}} {{route}} {{status}}"}]
    },
    {
      "id": 11, "type": "piechart", "title": "Requests by service and route",
      "description": "Each service route's share of completed requests over the selected time range.",
      "gridPos": {"x": 16, "y": 14, "w": 8, "h": 8},
      "datasource": {"type": "prometheus", "uid": "${metrics}"},
      "fieldConfig": {"defaults": {"unit": "short", "decimals": 0, "color": {"mode": "palette-classic"}, "custom": {"hideFrom": {"legend": false, "tooltip": false, "viz": false}}}, "overrides": []},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "orientation": "auto", "pieType": "donut", "displayLabels": ["percent"], "legend": {"showLegend": true, "displayMode": "table", "placement": "right", "values": ["value", "percent"], "calcs": []}, "tooltip": {"mode": "single", "sort": "none"}},
      "targets": [{"refId": "A", "expr": "label_replace(sum by (job, service, route) (increase({__name__=~\"ankilabs_(api_gateway|sentence_lookup|dictionary_lookup)_http_request_duration_seconds_count\",namespace=\"ankilabs\"}[$__range])), \"service\", \"api-gateway\", \"job\", \"monitoring/ankilabs-api-gateway\")", "legendFormat": "{{service}} {{route}}", "instant": true, "range": false}]
    },
    {
      "id": 12, "type": "timeseries", "title": "Observed server failures",
      "description": "Completed requests that returned 5xx, per bar; any bar fires AnkiLabsRequestFailure. Find the request in the trace logs by time or request ID.",
      "gridPos": {"x": 0, "y": 22, "w": 12, "h": 7},
      "datasource": {"type": "prometheus", "uid": "${metrics}"},
      "fieldConfig": {"defaults": {"unit": "short", "custom": {"drawStyle": "bars", "lineWidth": 1, "fillOpacity": 80, "showPoints": "never", "spanNulls": false, "stacking": {"mode": "normal", "group": "A"}, "barAlignment": -1}, "color": {"mode": "palette-classic"}, "min": 0}, "overrides": []},
      "options": {"legend": {"showLegend": true, "displayMode": "list", "placement": "bottom", "calcs": []}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "interval": "15m",
      "targets": [{"refId": "A", "expr": "label_replace(sum by (job, service, route, status) (increase({__name__=~\"ankilabs_(api_gateway|sentence_lookup|dictionary_lookup)_http_request_duration_seconds_count\",namespace=\"ankilabs\",status=~\"5..\"}[$__rate_interval])), \"service\", \"api-gateway\", \"job\", \"monitoring/ankilabs-api-gateway\")", "legendFormat": "{{service}} {{route}} {{status}}"}]
    },
    {
      "id": 13, "type": "timeseries", "title": "5xx share",
      "description": "Share of each service's requests that returned 5xx over a rolling 15 minutes; empty without traffic.",
      "gridPos": {"x": 12, "y": 22, "w": 12, "h": 7},
      "datasource": {"type": "prometheus", "uid": "${metrics}"},
      "fieldConfig": {"defaults": {"unit": "percent", "custom": {"drawStyle": "line", "lineWidth": 1, "fillOpacity": 10, "showPoints": "never", "spanNulls": false, "stacking": {"mode": "none", "group": "A"}}, "color": {"mode": "palette-classic"}, "min": 0}, "overrides": []},
      "options": {"legend": {"showLegend": true, "displayMode": "list", "placement": "bottom", "calcs": []}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [{"refId": "A", "expr": "100 * (sum(increase(ankilabs_api_gateway_http_request_duration_seconds_count{namespace=\"ankilabs\",status=~\"5..\"}[15m])) or sum(increase(ankilabs_api_gateway_http_request_duration_seconds_count{namespace=\"ankilabs\"}[15m])) * 0) / (sum(increase(ankilabs_api_gateway_http_request_duration_seconds_count{namespace=\"ankilabs\"}[15m])) > 0)", "legendFormat": "api-gateway"}, {"refId": "B", "expr": "100 * (sum(increase(ankilabs_sentence_lookup_http_request_duration_seconds_count{namespace=\"ankilabs\",status=~\"5..\"}[15m])) or sum(increase(ankilabs_sentence_lookup_http_request_duration_seconds_count{namespace=\"ankilabs\"}[15m])) * 0) / (sum(increase(ankilabs_sentence_lookup_http_request_duration_seconds_count{namespace=\"ankilabs\"}[15m])) > 0)", "legendFormat": "sentence-lookup"}, {"refId": "C", "expr": "100 * (sum(increase(ankilabs_dictionary_lookup_http_request_duration_seconds_count{namespace=\"ankilabs\",status=~\"5..\"}[15m])) or sum(increase(ankilabs_dictionary_lookup_http_request_duration_seconds_count{namespace=\"ankilabs\"}[15m])) * 0) / (sum(increase(ankilabs_dictionary_lookup_http_request_duration_seconds_count{namespace=\"ankilabs\"}[15m])) > 0)", "legendFormat": "dictionary-lookup"}]
    },
    {
      "id": 14, "type": "row", "title": "Latency", "collapsed": false,
      "gridPos": {"x": 0, "y": 29, "w": 24, "h": 1},
      "panels": []
    },
    {
      "id": 15, "type": "heatmap", "title": "api-gateway latency distribution",
      "description": "Completed api-gateway requests per latency bucket and 5-minute column; darker cells hold more requests. A band moving up means requests got slower.",
      "gridPos": {"x": 0, "y": 30, "w": 8, "h": 8},
      "datasource": {"type": "prometheus", "uid": "${metrics}"},
      "interval": "5m",
      "fieldConfig": {"defaults": {"custom": {"hideFrom": {"legend": false, "tooltip": false, "viz": false}, "scaleDistribution": {"type": "linear"}}}, "overrides": []},
      "options": {"calculate": false, "cellGap": 1, "cellValues": {"unit": "short"}, "color": {"mode": "scheme", "scheme": "Oranges", "fill": "dark-orange", "scale": "exponential", "exponent": 0.5, "steps": 64, "reverse": false}, "exemplars": {"color": "rgba(255,0,255,0.7)"}, "filterValues": {"le": 1e-09}, "legend": {"show": true}, "rowsFrame": {"layout": "auto"}, "showValue": "never", "tooltip": {"mode": "single", "yHistogram": false, "showColorScale": false}, "yAxis": {"axisPlacement": "left", "reverse": false, "unit": "s"}, "selectionMode": "x"},
      "targets": [{"refId": "A", "expr": "sum by (le) (increase(ankilabs_api_gateway_http_request_duration_seconds_bucket{namespace=\"ankilabs\"}[$__rate_interval]))", "legendFormat": "{{le}}", "format": "heatmap"}]
    },
    {
      "id": 16, "type": "heatmap", "title": "sentence-lookup latency distribution",
      "description": "Completed sentence-lookup requests per latency bucket and 5-minute column; darker cells hold more requests. A band moving up means requests got slower.",
      "gridPos": {"x": 8, "y": 30, "w": 8, "h": 8},
      "datasource": {"type": "prometheus", "uid": "${metrics}"},
      "interval": "5m",
      "fieldConfig": {"defaults": {"custom": {"hideFrom": {"legend": false, "tooltip": false, "viz": false}, "scaleDistribution": {"type": "linear"}}}, "overrides": []},
      "options": {"calculate": false, "cellGap": 1, "cellValues": {"unit": "short"}, "color": {"mode": "scheme", "scheme": "Oranges", "fill": "dark-orange", "scale": "exponential", "exponent": 0.5, "steps": 64, "reverse": false}, "exemplars": {"color": "rgba(255,0,255,0.7)"}, "filterValues": {"le": 1e-09}, "legend": {"show": true}, "rowsFrame": {"layout": "auto"}, "showValue": "never", "tooltip": {"mode": "single", "yHistogram": false, "showColorScale": false}, "yAxis": {"axisPlacement": "left", "reverse": false, "unit": "s"}, "selectionMode": "x"},
      "targets": [{"refId": "A", "expr": "sum by (le) (increase(ankilabs_sentence_lookup_http_request_duration_seconds_bucket{namespace=\"ankilabs\"}[$__rate_interval]))", "legendFormat": "{{le}}", "format": "heatmap"}]
    },
    {
      "id": 17, "type": "heatmap", "title": "dictionary-lookup latency distribution",
      "description": "Completed dictionary-lookup requests per latency bucket and 5-minute column; darker cells hold more requests. A band moving up means requests got slower.",
      "gridPos": {"x": 16, "y": 30, "w": 8, "h": 8},
      "datasource": {"type": "prometheus", "uid": "${metrics}"},
      "interval": "5m",
      "fieldConfig": {"defaults": {"custom": {"hideFrom": {"legend": false, "tooltip": false, "viz": false}, "scaleDistribution": {"type": "linear"}}}, "overrides": []},
      "options": {"calculate": false, "cellGap": 1, "cellValues": {"unit": "short"}, "color": {"mode": "scheme", "scheme": "Oranges", "fill": "dark-orange", "scale": "exponential", "exponent": 0.5, "steps": 64, "reverse": false}, "exemplars": {"color": "rgba(255,0,255,0.7)"}, "filterValues": {"le": 1e-09}, "legend": {"show": true}, "rowsFrame": {"layout": "auto"}, "showValue": "never", "tooltip": {"mode": "single", "yHistogram": false, "showColorScale": false}, "yAxis": {"axisPlacement": "left", "reverse": false, "unit": "s"}, "selectionMode": "x"},
      "targets": [{"refId": "A", "expr": "sum by (le) (increase(ankilabs_dictionary_lookup_http_request_duration_seconds_bucket{namespace=\"ankilabs\"}[$__rate_interval]))", "legendFormat": "{{le}}", "format": "heatmap"}]
    },
    {
      "id": 18, "type": "timeseries", "title": "p95 latency",
      "description": "95th percentile request duration per service over a rolling 15 minutes, shown only with at least 5 requests in that window.",
      "gridPos": {"x": 0, "y": 38, "w": 12, "h": 7},
      "datasource": {"type": "prometheus", "uid": "${metrics}"},
      "fieldConfig": {"defaults": {"unit": "s", "custom": {"drawStyle": "line", "lineWidth": 1, "fillOpacity": 10, "showPoints": "never", "spanNulls": false, "stacking": {"mode": "none", "group": "A"}}, "color": {"mode": "palette-classic"}, "min": 0}, "overrides": []},
      "options": {"legend": {"showLegend": true, "displayMode": "list", "placement": "bottom", "calcs": []}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [{"refId": "A", "expr": "histogram_quantile(0.95, sum by (job, le) (increase(ankilabs_api_gateway_http_request_duration_seconds_bucket{namespace=\"ankilabs\"}[15m]))) and on (job) sum by (job) (increase(ankilabs_api_gateway_http_request_duration_seconds_count{namespace=\"ankilabs\"}[15m])) >= 5", "legendFormat": "api-gateway"}, {"refId": "B", "expr": "histogram_quantile(0.95, sum by (job, le) (increase(ankilabs_sentence_lookup_http_request_duration_seconds_bucket{namespace=\"ankilabs\"}[15m]))) and on (job) sum by (job) (increase(ankilabs_sentence_lookup_http_request_duration_seconds_count{namespace=\"ankilabs\"}[15m])) >= 5", "legendFormat": "sentence-lookup"}, {"refId": "C", "expr": "histogram_quantile(0.95, sum by (job, le) (increase(ankilabs_dictionary_lookup_http_request_duration_seconds_bucket{namespace=\"ankilabs\"}[15m]))) and on (job) sum by (job) (increase(ankilabs_dictionary_lookup_http_request_duration_seconds_count{namespace=\"ankilabs\"}[15m])) >= 5", "legendFormat": "dictionary-lookup"}]
    },
    {
      "id": 19, "type": "timeseries", "title": "Mean latency by route",
      "description": "Average completed request duration per route over 15 minutes, including failures. Missing or zero samples are not a zero-second response.",
      "gridPos": {"x": 12, "y": 38, "w": 12, "h": 7},
      "datasource": {"type": "prometheus", "uid": "${metrics}"},
      "fieldConfig": {"defaults": {"unit": "s", "custom": {"drawStyle": "line", "lineWidth": 1, "fillOpacity": 10, "showPoints": "never", "spanNulls": false, "stacking": {"mode": "none", "group": "A"}}, "color": {"mode": "palette-classic"}, "min": 0}, "overrides": []},
      "options": {"legend": {"showLegend": true, "displayMode": "list", "placement": "bottom", "calcs": []}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [{"refId": "A", "expr": "label_replace(sum by (job, service, route) (increase({__name__=~\"ankilabs_(api_gateway|sentence_lookup|dictionary_lookup)_http_request_duration_seconds_sum\",namespace=\"ankilabs\"}[15m])) / sum by (job, service, route) (increase({__name__=~\"ankilabs_(api_gateway|sentence_lookup|dictionary_lookup)_http_request_duration_seconds_count\",namespace=\"ankilabs\"}[15m])), \"service\", \"api-gateway\", \"job\", \"monitoring/ankilabs-api-gateway\")", "legendFormat": "{{service}} {{route}}"}]
    },
    {
      "id": 20, "type": "row", "title": "Gateway to lookups", "collapsed": false,
      "gridPos": {"x": 0, "y": 45, "w": 24, "h": 1},
      "panels": []
    },
    {
      "id": 21, "type": "timeseries", "title": "Upstream calls by status",
      "description": "Gateway calls to Sentence and Dictionary Lookup per bar and status. 5xx, timeout and unavailable are failures and fire AnkiLabsUpstreamFailure.",
      "gridPos": {"x": 0, "y": 46, "w": 8, "h": 7},
      "datasource": {"type": "prometheus", "uid": "${metrics}"},
      "fieldConfig": {"defaults": {"unit": "short", "custom": {"drawStyle": "bars", "lineWidth": 1, "fillOpacity": 80, "showPoints": "never", "spanNulls": false, "stacking": {"mode": "normal", "group": "A"}, "barAlignment": -1}, "color": {"mode": "palette-classic"}, "min": 0}, "overrides": []},
      "options": {"legend": {"showLegend": true, "displayMode": "list", "placement": "bottom", "calcs": []}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "interval": "15m",
      "targets": [{"refId": "A", "expr": "sum by (service, status) (increase(ankilabs_api_gateway_upstream_request_duration_seconds_count{namespace=\"ankilabs\",service=~\"Sentence Lookup|Dictionary Lookup\"}[$__rate_interval]))", "legendFormat": "{{service}} {{status}}"}]
    },
    {
      "id": 22, "type": "heatmap", "title": "Upstream latency distribution",
      "description": "Gateway-to-lookup calls per latency bucket and 5-minute column, both lookups together.",
      "gridPos": {"x": 8, "y": 46, "w": 8, "h": 7},
      "datasource": {"type": "prometheus", "uid": "${metrics}"},
      "interval": "5m",
      "fieldConfig": {"defaults": {"custom": {"hideFrom": {"legend": false, "tooltip": false, "viz": false}, "scaleDistribution": {"type": "linear"}}}, "overrides": []},
      "options": {"calculate": false, "cellGap": 1, "cellValues": {"unit": "short"}, "color": {"mode": "scheme", "scheme": "Oranges", "fill": "dark-orange", "scale": "exponential", "exponent": 0.5, "steps": 64, "reverse": false}, "exemplars": {"color": "rgba(255,0,255,0.7)"}, "filterValues": {"le": 1e-09}, "legend": {"show": true}, "rowsFrame": {"layout": "auto"}, "showValue": "never", "tooltip": {"mode": "single", "yHistogram": false, "showColorScale": false}, "yAxis": {"axisPlacement": "left", "reverse": false, "unit": "s"}, "selectionMode": "x"},
      "targets": [{"refId": "A", "expr": "sum by (le) (increase(ankilabs_api_gateway_upstream_request_duration_seconds_bucket{namespace=\"ankilabs\",service=~\"Sentence Lookup|Dictionary Lookup\"}[$__rate_interval]))", "legendFormat": "{{le}}", "format": "heatmap"}]
    },
    {
      "id": 23, "type": "timeseries", "title": "Upstream mean duration",
      "description": "Average gateway-to-lookup call time over 15 minutes; empty when there were no calls. When it rises, check the stages on Search & PostgreSQL.",
      "gridPos": {"x": 16, "y": 46, "w": 8, "h": 7},
      "datasource": {"type": "prometheus", "uid": "${metrics}"},
      "fieldConfig": {"defaults": {"unit": "s", "custom": {"drawStyle": "line", "lineWidth": 1, "fillOpacity": 10, "showPoints": "never", "spanNulls": false, "stacking": {"mode": "none", "group": "A"}}, "color": {"mode": "palette-classic"}, "min": 0}, "overrides": []},
      "options": {"legend": {"showLegend": true, "displayMode": "list", "placement": "bottom", "calcs": []}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [{"refId": "A", "expr": "sum by (service) (increase(ankilabs_api_gateway_upstream_request_duration_seconds_sum{namespace=\"ankilabs\",service=~\"Sentence Lookup|Dictionary Lookup\"}[15m])) / sum by (service) (increase(ankilabs_api_gateway_upstream_request_duration_seconds_count{namespace=\"ankilabs\",service=~\"Sentence Lookup|Dictionary Lookup\"}[15m]))", "legendFormat": "{{service}}"}]
    },
    {
      "id": 24, "type": "row", "title": "Resources", "collapsed": false,
      "gridPos": {"x": 0, "y": 53, "w": 24, "h": 1},
      "panels": []
    },
    {
      "id": 25, "type": "bargauge", "title": "Memory working set of limit",
      "description": "Working set as a share of the configured memory limit; containers without a limit are absent. Near 100% the container is OOM-killed.",
      "gridPos": {"x": 0, "y": 54, "w": 8, "h": 8},
      "datasource": {"type": "prometheus", "uid": "${metrics}"},
      "fieldConfig": {"defaults": {"unit": "percent", "min": 0, "max": 100, "color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 80}, {"color": "red", "value": 90}]}}, "overrides": []},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "orientation": "horizontal", "displayMode": "lcd", "valueMode": "color", "namePlacement": "auto", "showUnfilled": true, "sizing": "auto", "minVizWidth": 8, "minVizHeight": 16, "maxVizHeight": 300, "legend": {"showLegend": false, "displayMode": "list", "placement": "bottom", "calcs": []}},
      "targets": [{"refId": "A", "expr": "100 * max by (namespace, pod, container) (container_memory_working_set_bytes{namespace=\"ankilabs\",container!=\"\",container!=\"POD\"}) / on (namespace, pod, container) (max by (namespace, pod, container) (kube_pod_container_resource_limits{namespace=\"ankilabs\",resource=\"memory\",unit=\"byte\"}) > 0)", "legendFormat": "{{pod}} / {{container}}"}]
    },
    {
      "id": 26, "type": "timeseries", "title": "Container CPU",
      "description": "CPU cores used per AnkiLabs container. Compare with request latency before changing resources.",
      "gridPos": {"x": 8, "y": 54, "w": 8, "h": 8},
      "datasource": {"type": "prometheus", "uid": "${metrics}"},
      "fieldConfig": {"defaults": {"unit": "cores", "custom": {"drawStyle": "line", "lineWidth": 1, "fillOpacity": 10, "showPoints": "never", "spanNulls": false, "stacking": {"mode": "none", "group": "A"}}, "color": {"mode": "palette-classic"}, "min": 0}, "overrides": []},
      "options": {"legend": {"showLegend": true, "displayMode": "list", "placement": "bottom", "calcs": []}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [{"refId": "A", "expr": "sum by (pod, container) (rate(container_cpu_usage_seconds_total{namespace=\"ankilabs\",container!=\"\",container!=\"POD\"}[$__rate_interval]))", "legendFormat": "{{pod}} {{container}}"}]
    },
    {
      "id": 27, "type": "timeseries", "title": "Container restarts",
      "description": "Container restarts per bar. Check Recent OOM restarts and the warning logs for the cause.",
      "gridPos": {"x": 16, "y": 54, "w": 8, "h": 8},
      "datasource": {"type": "prometheus", "uid": "${metrics}"},
      "fieldConfig": {"defaults": {"unit": "short", "custom": {"drawStyle": "bars", "lineWidth": 1, "fillOpacity": 80, "showPoints": "never", "spanNulls": false, "stacking": {"mode": "normal", "group": "A"}, "barAlignment": -1}, "color": {"mode": "palette-classic"}, "min": 0}, "overrides": []},
      "options": {"legend": {"showLegend": true, "displayMode": "list", "placement": "bottom", "calcs": []}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "interval": "15m",
      "targets": [{"refId": "A", "expr": "sum by (pod, container) (increase(kube_pod_container_status_restarts_total{namespace=\"ankilabs\"}[$__rate_interval]))", "legendFormat": "{{pod}} {{container}}"}]
    },
    {
      "id": 28, "type": "table", "title": "Recent OOM restarts",
      "description": "Containers whose last termination was an OOM kill and that restarted in the last 15 minutes (ApplicationOOMKilled). Empty means none observed, not complete coverage.",
      "gridPos": {"x": 0, "y": 62, "w": 24, "h": 5},
      "datasource": {"type": "prometheus", "uid": "${metrics}"},
      "fieldConfig": {"defaults": {"custom": {"align": "auto", "cellOptions": {"type": "auto"}, "inspect": false, "filterable": true}}, "overrides": [{"matcher": {"id": "byName", "options": "reason"}, "properties": [{"id": "custom.cellOptions", "value": {"type": "color-background"}}, {"id": "color", "value": {"mode": "fixed", "fixedColor": "red"}}]}]},
      "options": {"showHeader": true, "cellHeight": "sm", "footer": {"show": false, "reducer": ["sum"], "countRows": false, "fields": ""}},
      "transformations": [{"id": "organize", "options": {"excludeByName": {"Time": true, "__name__": true, "Value": true, "endpoint": true, "instance": true, "job": true, "service": true, "uid": true}, "indexByName": {"namespace": 0, "pod": 1, "container": 2, "reason": 3}, "renameByName": {}}}],
      "targets": [{"refId": "A", "expr": "(kube_pod_container_status_last_terminated_reason{namespace=\"ankilabs\",reason=\"OOMKilled\"} == 1) and on (namespace, pod, container) (increase(kube_pod_container_status_restarts_total{namespace=\"ankilabs\"}[15m]) > 0)", "instant": true, "range": false, "format": "table"}]
    },
    {
      "id": 29, "type": "row", "title": "Failure counters since process start", "collapsed": true,
      "gridPos": {"x": 0, "y": 67, "w": 24, "h": 1},
      "panels": [
        {
          "id": 30, "type": "table", "title": "HTTP 5xx counters since process start",
          "description": "Raw 5xx counters. A first failure can create a series before its first scrape, making a window increase look zero; compare with logs. New scrape discovery can reveal historical failures.",
          "gridPos": {"x": 0, "y": 68, "w": 12, "h": 8},
          "datasource": {"type": "prometheus", "uid": "${metrics}"},
          "fieldConfig": {"defaults": {"custom": {"align": "auto", "cellOptions": {"type": "auto"}, "inspect": false, "filterable": true}}, "overrides": [{"matcher": {"id": "byName", "options": "Service"}, "properties": [{"id": "mappings", "value": [{"type": "regex", "options": {"pattern": "ankilabs_(.+)_http_request_duration_seconds_count", "result": {"text": "$1", "index": 0}}}]}]}, {"matcher": {"id": "byName", "options": "Count"}, "properties": [{"id": "thresholds", "value": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 1}]}}, {"id": "color", "value": {"mode": "thresholds"}}, {"id": "custom.cellOptions", "value": {"type": "color-background", "mode": "basic"}}, {"id": "decimals", "value": 0}]}]},
          "options": {"showHeader": true, "cellHeight": "sm", "footer": {"show": false, "reducer": ["sum"], "countRows": false, "fields": ""}},
          "transformations": [{"id": "organize", "options": {"excludeByName": {"Time": true, "container": true, "endpoint": true, "instance": true, "namespace": true, "job": true, "service": true, "method": true}, "indexByName": {"__name__": 0, "route": 1, "status": 2, "pod": 3, "Value": 4}, "renameByName": {"__name__": "Service", "Value": "Count"}}}],
          "targets": [{"refId": "A", "expr": "{__name__=~\"ankilabs_(api_gateway|sentence_lookup|dictionary_lookup)_http_request_duration_seconds_count\",namespace=\"ankilabs\",status=~\"5..\"}", "instant": true, "range": false, "format": "table"}]
        },
        {
          "id": 31, "type": "table", "title": "Lookup upstream failure counters since gateway start",
          "description": "Raw gateway counters of failed lookup calls (5xx, timeout, unavailable) since each gateway process started. They catch failures a 15-minute window can miss and reset when the gateway restarts.",
          "gridPos": {"x": 12, "y": 68, "w": 12, "h": 8},
          "datasource": {"type": "prometheus", "uid": "${metrics}"},
          "fieldConfig": {"defaults": {"custom": {"align": "auto", "cellOptions": {"type": "auto"}, "inspect": false, "filterable": true}}, "overrides": [{"matcher": {"id": "byName", "options": "Count"}, "properties": [{"id": "thresholds", "value": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 1}]}}, {"id": "color", "value": {"mode": "thresholds"}}, {"id": "custom.cellOptions", "value": {"type": "color-background", "mode": "basic"}}, {"id": "decimals", "value": 0}]}]},
          "options": {"showHeader": true, "cellHeight": "sm", "footer": {"show": false, "reducer": ["sum"], "countRows": false, "fields": ""}},
          "transformations": [{"id": "organize", "options": {"excludeByName": {"Time": true, "__name__": true, "container": true, "endpoint": true, "instance": true, "namespace": true, "job": true, "method": true}, "indexByName": {"service": 0, "path": 1, "status": 2, "pod": 3, "Value": 4}, "renameByName": {"Value": "Count"}}}],
          "targets": [{"refId": "A", "expr": "ankilabs_api_gateway_upstream_request_duration_seconds_count{namespace=\"ankilabs\",service=~\"Sentence Lookup|Dictionary Lookup\",status=~\"5..|timeout|unavailable\"}", "instant": true, "range": false, "format": "table"}]
        }
      ]
    },
    {
      "id": 32, "type": "row", "title": "Logs", "collapsed": true,
      "gridPos": {"x": 0, "y": 68, "w": 24, "h": 1},
      "panels": [
        {
          "id": 33, "type": "logs", "title": "Core request trace: started, stage and completion breadcrumbs",
          "description": "Started, stage and completed events from the gateway and lookups, filtered by the request_id variable (parsed at query time). A request killed before completing shows only started events and has no latency sample.",
          "gridPos": {"x": 0, "y": 69, "w": 24, "h": 10},
          "datasource": {"type": "loki", "uid": "${logs}"},
          "options": {"showTime": true, "wrapLogMessage": true, "sortOrder": "Descending"},
          "targets": [{"refId": "A", "expr": "{namespace=\"ankilabs\",app=~\"api-gateway|dictionary-lookup|sentence-lookup\"} | json | request_id=~`.*${request_id:regex}.*`"}]
        },
        {
          "id": 34, "type": "logs", "title": "Core warnings/errors and unparsed/unknown records",
          "description": "Preserves raw records. These are log records, not a count of failed requests.",
          "gridPos": {"x": 0, "y": 79, "w": 24, "h": 9},
          "datasource": {"type": "loki", "uid": "${logs}"},
          "options": {"showTime": true, "wrapLogMessage": true, "sortOrder": "Descending"},
          "targets": [{"refId": "A", "expr": "{namespace=\"ankilabs\",app=~\"api-gateway|dictionary-lookup|sentence-lookup\",severity=~\"WARNING|ERROR|CRITICAL|UNKNOWN\"}"}]
        }
      ]
    }
  ]
}
